---
/**
 * 404 — "no route claimed that name".
 * Shares the landing page's token system and theme behavior.
 */

// Self-hosted fonts avoid third-party font requests.
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import SiteHeader from '../components/SiteHeader.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 | routeup</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#222422" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#E9E3D2" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          theme =
            localStorage.getItem('routeup-theme') ||
            (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch (_e) {}
        document.documentElement.dataset.theme = theme;
        var bg = theme === 'light' ? '#E9E3D2' : '#222422';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
          m.setAttribute('content', bg);
        });
      })();
    </script>
  </head>

  <body>
    <header class="ru-page-header">
      <div class="ru-page-header__inner"><SiteHeader /></div>
    </header>

    <main class="ru-404__main">
      <p class="ru-404__eyebrow">404 · no route claimed that name</p>
      <h1 class="ru-404__h1">Nothing is listening here.</h1>
      <p class="ru-404__copy">Either the page moved, or somebody Ctrl-C'd it. Both are fixable.</p>
      <div class="ru-404__ctas">
        <a href="/" class="ru-404__btn">Home</a>
        <a href="/docs" class="ru-404__btn ru-404__btn--ghost">Docs</a>
        <a href="/llms.txt" class="ru-404__btn ru-404__btn--ghost">Agent index</a>
        <a href="/sitemap-index.xml" class="ru-404__btn ru-404__btn--ghost">Sitemap</a>
      </div>
    </main>

    <style is:global>
      :root{--logo-cross:rgba(245,239,225,.68);--hair-strong:rgba(245,239,225,.28);--hair-soft:rgba(245,239,225,.12);--bg:#222422;--panel:#2C2F2B;--txt:#F8F2E6;--sec:#D5CEC1;--mint-hover:#A4F0DE;--mint:#79E2CB;--amb:#FFB76B;--mint-bd-strong:rgba(121,226,203,.58)}
      :root[data-theme="light"]{--logo-cross:rgba(27,24,18,.56);--hair-strong:rgba(27,24,18,.3);--hair-soft:rgba(27,24,18,.12);--bg:#E9E3D2;--panel:#FFFAF0;--txt:#1B1812;--sec:#464034;--mint-hover:#044946;--mint:#075D59;--amb:#A44A16;--mint-bd-strong:rgba(7,93,89,.62)}
      @media (prefers-color-scheme: light){:root:not([data-theme]){--logo-cross:rgba(27,24,18,.56);--hair-strong:rgba(27,24,18,.3);--hair-soft:rgba(27,24,18,.12);--bg:#E9E3D2;--panel:#FFFAF0;--txt:#1B1812;--sec:#464034;--mint-hover:#044946;--mint:#075D59;--amb:#A44A16;--mint-bd-strong:rgba(7,93,89,.62)}}

      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--txt);
        font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      *, *::before, *::after { box-sizing: border-box; }
      a { color: var(--mint); text-decoration: none; }
      a:hover { color: var(--mint-hover); }
      ::selection { background: var(--mint); color: var(--bg); }
      :focus-visible { outline: 2px solid var(--mint); outline-offset: 2px; }

      .ru-page-header__inner { max-width: 1240px; margin: 0 auto; padding: 0 40px; }

      .ru-404__main { padding: 88px 40px 96px; text-align: center; }
      .ru-404__eyebrow { margin: 0 0 22px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--amb); }
      .ru-404__h1 { margin: 0; font-size: 46px; letter-spacing: -.035em; font-weight: 700; line-height: 1.1; }
      .ru-404__copy { margin: 16px auto 32px; max-width: 44ch; font-size: 16px; color: var(--sec); line-height: 1.6; }
      .ru-404__ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
      .ru-404__btn {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 20px;
        background: var(--mint);
        color: var(--bg);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 700;
        border-radius: 3px;
      }
      .ru-404__btn:hover { background: var(--mint-hover); color: var(--bg); }
      .ru-404__btn--ghost {
        background: transparent;
        border: 1px solid var(--hair-strong);
        color: var(--txt);
        font-weight: 400;
      }
      .ru-404__btn--ghost:hover { background: transparent; border-color: var(--mint-bd-strong); color: var(--txt); }
      @media (max-width: 820px) { .ru-page-header__inner { padding: 0 22px; } }
    </style>
  </body>
</html>
