---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import SiteHeader from '../components/SiteHeader.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>Privacy | routeup</title>
    <meta
      name="description"
      content="How routeup.dev handles website analytics and hosted-token requests."
    />
    <link rel="canonical" href="https://routeup.dev/privacy/" />
    <link rel="alternate" type="text/markdown" href="/privacy.md" />
    <link rel="describedby" href="/llms.txt" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#222422" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#E9E3D2" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          theme =
            localStorage.getItem('routeup-theme') ||
            (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch (_e) {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <header class="ru-page-header">
      <div class="ru-page-header__inner"><SiteHeader /></div>
    </header>

    <main>
      <h1>Privacy</h1>
      <p class="ru-privacy__updated">Last updated August 22, 2026</p>
      <p class="ru-privacy__intro">
        This page explains what routeup.dev collects. It covers this website and the hosted-token
        request form, not applications exposed with Routeup or independently operated servers.
      </p>

      <section>
        <h2>Routeup CLI</h2>
        <p>
          The Routeup CLI has no product analytics or telemetry. Local routing works without an
          account and without contacting a Routeup server. Public exposure uses the server selected
          by the user.
        </p>
      </section>

      <section>
        <h2>Website analytics</h2>
        <p>
          routeup.dev uses a self-hosted instance of{' '}
          <a href="https://umami.is/docs/faq">Umami</a>. Its tracker does not use cookies or store
          personally identifiable information. It may record page views, referrers, browser and
          operating-system information, device type, and approximate country in anonymized form.
        </p>
        <p>
          Self-hosted Umami data is retained until it is manually deleted. Your theme preference is
          stored only in your browser.
        </p>
      </section>

      <section>
        <h2>Hosted-token requests</h2>
        <p>
          The token request form collects the email address and preferred namespace you enter. The
          request is delivered through{' '}<a href="https://resend.com/legal/privacy-policy">Resend</a>{' '}
          so it can be reviewed and answered. Routeup does not add your IP address or location to
          the request.
        </p>
        <p>
          These emails do not have an automatic deletion schedule. You can ask for a request to be
          deleted by emailing <a href="mailto:help@routeup.dev">help@routeup.dev</a>.
        </p>
      </section>

      <section>
        <h2>Hosting</h2>
        <p>
          <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare</a>{' '}hosts and delivers the
          website and processes network requests needed to operate and protect it. The hosted-token
          form is optional, and you can block the analytics script in your browser.
        </p>
        <p>
          Routeup's hosted public edge runs on <a href="https://fly.io/legal/privacy-policy/">Fly.io</a>{' '}
          in its <a href="https://fly.io/docs/reference/regions/">Singapore (<code>sin</code>) region</a>.
          When you enable public exposure, requests pass through that infrastructure before they
          travel over an encrypted Routeup tunnel to your local agent.
        </p>
      </section>

      <section>
        <h2>Contact</h2>
        <p>
          For privacy questions or deletion requests, email{' '}
          <a href="mailto:help@routeup.dev">help@routeup.dev</a>.
        </p>
      </section>
    </main>

    <footer>
      <a href="/">Home</a>
      <a href="/privacy.md">Markdown version</a>
    </footer>

    <style is:global>
      :root{--logo-cross:rgba(245,239,225,.68);--bg:#222422;--panel:#2c2f2b;--txt:#f8f2e6;--sec:#d5cec1;--dim:#a39b90;--mint:#79e2cb;--mint-hover:#a4f0de;--mint-bd-strong:rgba(121,226,203,.58);--hair-strong:rgba(245,239,225,.28);--hair:rgba(245,239,225,.17);--hair-soft:rgba(245,239,225,.12)}
      :root[data-theme="light"]{--logo-cross:rgba(27,24,18,.56);--bg:#e9e3d2;--panel:#fffaf0;--txt:#1b1812;--sec:#464034;--dim:#665e51;--mint:#075d59;--mint-hover:#044946;--mint-bd-strong:rgba(7,93,89,.62);--hair-strong:rgba(27,24,18,.3);--hair:rgba(27,24,18,.18);--hair-soft:rgba(27,24,18,.12)}
      @media(prefers-color-scheme:light){:root:not([data-theme]){--logo-cross:rgba(27,24,18,.56);--bg:#e9e3d2;--panel:#fffaf0;--txt:#1b1812;--sec:#464034;--dim:#665e51;--mint:#075d59;--mint-hover:#044946;--mint-bd-strong:rgba(7,93,89,.62);--hair-strong:rgba(27,24,18,.3);--hair:rgba(27,24,18,.18);--hair-soft:rgba(27,24,18,.12)}}
      html,body{margin:0;padding:0}body{background:var(--bg);color:var(--txt);font-family:'Space Grotesk',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}*,:before,:after{box-sizing:border-box}a{color:var(--mint);text-underline-offset:3px}a:hover{color:var(--mint-hover)}:focus-visible{outline:2px solid var(--mint);outline-offset:3px}::selection{background:var(--mint);color:var(--bg)}
      .ru-page-header{position:sticky;top:0;z-index:10;background:var(--bg)}.ru-page-header__inner{max-width:1240px;margin:0 auto;padding:0 40px}
      main{width:min(680px,calc(100% - 48px));margin:0 auto;padding:84px 0 96px}h1{margin:0;font-size:clamp(42px,7vw,64px);line-height:1;letter-spacing:-.045em}.ru-privacy__updated{margin:16px 0 0;color:var(--dim);font-family:'JetBrains Mono',monospace;font-size:11px}.ru-privacy__intro{margin:36px 0 58px;color:var(--sec);font-size:19px;line-height:1.65}section{padding:30px 0;border-top:1px solid var(--hair)}h2{margin:0 0 12px;font-size:22px;letter-spacing:-.02em}section p{margin:0 0 14px;color:var(--sec);font-size:16px;line-height:1.75}section p:last-child{margin-bottom:0}footer{min-height:64px;border-top:1px solid var(--hair-soft);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px 28px;font-family:'JetBrains Mono',monospace;font-size:11px}footer a{color:var(--sec)}
      @media(max-width:820px){.ru-page-header__inner{padding:0 22px}}
      @media(max-width:600px){main{width:calc(100% - 36px);padding:58px 0 72px}.ru-privacy__intro{margin:28px 0 44px;font-size:17px}section{padding:26px 0}footer{align-items:flex-start;flex-direction:column}}
    </style>
  </body>
</html>
