      .ru-modes--config { align-items: stretch; }
      .ru-modes--config .ru-mode { display: flex; flex-direction: column; }
      .ru-modes--config .ru-mode p { margin-top: auto; padding-top: 1.1rem; }
      .ru-mode { min-width: 0; padding: 1.5rem 1.6rem 1.7rem; background: var(--bg-elev); border: 1px solid var(--rule); }
      .ru-mode h3 {
