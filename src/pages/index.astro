function recipeSlug(title: string) {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

/** JSON syntax coloring uses a terminal-specific palette, separate from CLI output. */
function jsonSegs(line: string) {
  const KEY = C.jsonKey, PUNCT = C.jsonPunctuation, STR = C.jsonString, NUM = C.jsonNumber, LITERAL = C.jsonLiteral;
  const segs: { t: string; c: string }[] = [];
  const re = /("[^"]*")(\s*:)|("[^"]*")|(-?\d+)|(true|false)/g;
  let last = 0;
  let m;
  while ((m = re.exec(line))) {
    if (m.index > last) segs.push({ t: line.slice(last, m.index), c: PUNCT });
    if (m[1]) {
      segs.push({ t: m[1], c: KEY });
      segs.push({ t: m[2], c: PUNCT });
    } else if (m[3]) {
      segs.push({ t: m[3], c: STR });
    } else {
      segs.push({ t: m[0], c: m[4] ? NUM : LITERAL });
    }
    last = re.lastIndex;
  }
  if (last < line.length) segs.push({ t: line.slice(last), c: PUNCT });
  if (!segs.length) segs.push({ t: line || ' ', c: PUNCT });
  return segs;
}

const runModes = [
  {
    id: 'serve',
    tab: 'Bring your app',
    title: 'Keep your current dev command.',
    body: 'Start your app as you do today. routeup owns only the stable route and optional public tunnel; use --detach to keep that owner in the background and routeup stop to release it.',
    config: [
      '{',
      '  "name": "example-app",',
      '  "targets": [',
      '    { "path": "/",    "port": 5173 },',
      '    { "path": "/api", "port": 8080 }',
      '  ],',
      '  "expose": {',
      '    "enabled": true,',
      '    "paths": ["/api/webhooks/*"]',
      '  }',
