      }

      /* a vertical chain of nodes connected by hops */
      .ru-chain { display: flex; flex-direction: column; }
      .ru-node {
        position: relative;
        padding-left: 1.55rem;
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
      }
      .ru-node::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.18rem;
