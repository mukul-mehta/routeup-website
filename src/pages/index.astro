      .ru-step { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; padding-bottom: clamp(1.8rem, 3.5vw, 2.6rem); }
      .ru-step:last-child { padding-bottom: 0; }
      .ru-step__num { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; margin-top: 0.15rem; background: var(--ink); color: var(--surface); font-family: var(--mono); font-size: 0.72rem; font-weight: 850; }
      .ru-step__body { min-width: 0; }
      .ru-step__body h3 { margin: 0 0 0.9rem; font-family: var(--mono); font-size: 1.05rem; letter-spacing: -0.01em; }
      .ru-step__note { margin: 0.7rem 0 0; color: var(--ink-soft); font-size: 0.88rem; }
      .ru-browser { display: flex; align-items: center; gap: 0.6rem; margin: 0; padding: 0.7rem 0.9rem; border: 2px solid var(--ink); background: var(--surface); }
      .ru-browser code { border: 0; background: transparent; padding: 0; color: var(--teal-dark); font-size: 0.85rem; }
      .ru-browser__dot { flex: 0 0 auto; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--teal); }

      /* ── HOW IT WORKS ── */
      .ru-flows { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; }
      .ru-flow { padding: clamp(1.2rem, 2.8vw, 1.9rem); border: 1px solid var(--rule); background: var(--surface); }
      .ru-flow--public { background: #f7eee3; }
      .ru-flow__header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.65rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--rule); }
      .ru-flow__header strong { font-family: var(--mono); }
      .ru-flow__header small { color: var(--ink-faint); }
      .ru-status { width: 0.6rem; height: 0.6rem; }
      .ru-status--local { background: var(--teal); }
      .ru-status--public { background: var(--public); }
      .ru-flow ol { padding: 0; margin: 1.2rem 0 0; list-style: none; counter-reset: flow; }
      .ru-flow li { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem; padding: 0 0 1.55rem 2rem; counter-increment: flow; }
      .ru-flow li:last-child { padding-bottom: 0; }
      .ru-flow li::before { content: counter(flow); position: absolute; left: 0; top: 0.05rem; display: grid; place-items: center; width: 1.05rem; height: 1.05rem; background: var(--ink); color: var(--surface); font-family: var(--mono); font-size: 0.58rem; font-weight: 850; }
      .ru-flow li:not(:last-child)::after { content: ""; position: absolute; left: 0.49rem; top: 1.15rem; bottom: 0.1rem; width: 1px; background: var(--ink); opacity: 0.3; }
      .ru-flow li > span { font-family: var(--mono); font-size: 0.84rem; font-weight: 800; }
      .ru-flow li > code, .ru-flow li > small { grid-column: 2; color: var(--ink-faint); font-size: 0.72rem; }

      /* ── BOUNDARIES ── */
      .ru-boundaries { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding: 1px; margin: 0; background: var(--rule); border: 1px solid var(--rule); list-style: none; }
      .ru-boundaries li { padding: 1.35rem; background: var(--surface); }
      .ru-boundaries strong, .ru-boundaries span { display: block; }
      .ru-boundaries strong { margin-bottom: 0.45rem; font-family: var(--mono); font-size: 0.86rem; }
      .ru-boundaries span { color: var(--ink-soft); font-size: 0.85rem; }

      /* ── FOOTER ── */
      .ru-footer { padding: 2.2rem 0 3rem; }
      .ru-footer__top { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; }
      .ru-footer nav { display: flex; flex-wrap: wrap; gap: 0.8rem 1.4rem; font-family: var(--mono); font-size: 0.72rem; font-weight: 650; }
      .ru-footer nav a:hover { color: var(--teal-dark); }
      .ru-footer > p { margin: 1rem 0 0; color: var(--ink-faint); font-family: var(--mono); font-size: 0.68rem; }

      /* ── RESPONSIVE ── */
      @media (max-width: 920px) {
        .ru-hero { grid-template-columns: 1fr; }
        .ru-hero h1 { max-width: 30ch; }
        .ru-section--split { grid-template-columns: 1fr; }
        .ru-section__intro { position: static; }
        .ru-mode-panel { grid-template-columns: 1fr; }
        .ru-flows { grid-template-columns: 1fr; }
        .ru-why-grid { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 700px) {
        body { font-size: 15px; }
        .ru-nav { align-items: flex-start; }
        .ru-nav__links { justify-content: flex-end; gap: 0.5rem 0.9rem; }
        .ru-nav__links a:nth-child(3) { display: none; }
        .ru-mode-tabs { grid-template-columns: 1fr; }
        .ru-recipe-tabs { grid-template-columns: 1fr 1fr; }
        .ru-boundaries { grid-template-columns: 1fr; }
        .ru-flow__header { grid-template-columns: auto 1fr; }
        .ru-flow__header small { grid-column: 2; }
        .ru-why-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 480px) {
        .ru-page { padding: 0 1rem; }
        .ru-nav { display: block; }
        .ru-nav__links { justify-content: flex-start; margin-top: 0.9rem; }
        .ru-nav__links a:nth-child(1), .ru-nav__links a:nth-child(3) { display: none; }
        .ru-hero { padding-top: 2rem; }
        .ru-proof { grid-template-columns: 1fr; }
        .ru-mode-tabs button { min-height: 5rem; }
        .ru-recipe-tabs { grid-template-columns: 1fr; }
        .ru-recipe-tabs button { min-height: 5rem; }
        .ru-mode-panel { padding: 1.1rem; }
        .ru-terminal { font-size: 0.74rem; }
        .ru-footer__top { align-items: flex-start; flex-direction: column; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: 1ms !important; }
      }
    </style>
  </body>
</html>
