---
/**
 * routeup.dev landing page.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>routeup | stable HTTPS names for local apps</title>
    <meta
      name="description"
      content="Give local apps stable, trusted HTTPS names. Keep your current dev command or let routeup run it, then expose the same targets publicly when needed."
    />
    <meta property="og:title" content="routeup | stable HTTPS names for local apps" />
    <meta
      property="og:description"
      content="Use example-app.localhost instead of localhost:3000. Local by default, public only when you choose."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://routeup.dev/" />
    <meta property="og:site_name" content="routeup" />
    <meta property="og:image" content="https://routeup.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="routeup | stable HTTPS names for local apps" />
    <meta
      name="twitter:description"
      content="Use example-app.localhost instead of localhost:3000. Local by default, public only when you choose."
    />
    <meta name="twitter:image" content="https://routeup.dev/og.png" />
    <link rel="canonical" href="https://routeup.dev/" />
    <meta name="theme-color" content="#e9e3d2" />
    <meta name="color-scheme" content="light" />
  </head>

  <body>
    <a href="#main-content" class="ru-skip">Skip to main content</a>
    <div role="status" class="ru-sr-live" aria-live="polite" aria-atomic="true"></div>

    <div class="ru-page">
      <header class="ru-nav">
        <a href="/" class="ru-brand" aria-label="routeup home">
          <img src="/favicon.svg" alt="" width="22" height="22" class="ru-brand__mark" />
          <span>routeup</span>
        </a>
        <nav class="ru-nav__links" aria-label="Primary">
          <a href="#recipes">Examples</a>
          <a href="#install">Install</a>
          <a href="#how">How it works</a>
          <a href="/docs">Docs</a>
          <a href="https://github.com/mukul-mehta/routeup" rel="noopener noreferrer" class="ru-nav__gh">GitHub &nearr;</a>
        </nav>
      </header>

      <main id="main-content">

        {/* ── HERO ── */}
        <section class="ru-hero">
          <div class="ru-hero__copy">
            <h1>Your local apps, by name.</h1>
            <p class="ru-hero__lede">
              <code>https://example-app.localhost</code> instead of <code>localhost:3000</code>.
              Stable names, trusted TLS, and a public URL when you need one.
              Point routeup at a port, or let it start your app.
            </p>
            <div class="ru-ctas">
              <a href="#recipes" class="ru-btn ru-btn--primary">See examples</a>
              <a href="/docs/getting-started/install" class="ru-btn ru-btn--ghost">Install routeup</a>
            </div>
            <ul class="ru-proof" aria-label="Product guarantees">
              <li>Trusted local HTTPS</li>
              <li>No account for local routes</li>
              <li>Open source</li>
              <li>Zero telemetry</li>
            </ul>
          </div>

          <div class="ru-hero__demo">
            <pre translate="no" class="ru-terminal ru-hero-terminal" data-title="terminal"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup</span>
<span class="t-dim">running: pnpm dev --port $PORT</span>

<span class="t-label">route:</span>   example-app
<span class="t-label">local:</span>   <span class="t-localurl">https://example-app.localhost</span>
<span class="t-label">public:</span>  <span class="t-publicurl">https://example-app.try.routeup.dev</span>
<span class="t-label">targets:</span>
  /        http://localhost:59370</code></pre>
          </div>

        </section>

        {/* ── RECIPES ── */}
        <section class="ru-section" id="recipes">
          <header class="ru-head">
            <h2>Pick a recipe.</h2>
          </header>

          <div class="ru-recipes" data-tabs>
            <div class="ru-recipe-tabs" role="tablist" aria-label="Routeup recipes">
              <button type="button" role="tab" aria-selected="true" aria-controls="recipe-compose" id="tab-recipe-compose" data-tab-target="recipe-compose">
                <span>01</span><strong>Frontend + API</strong><small>One origin, two targets</small>
              </button>
              <button type="button" role="tab" aria-selected="false" aria-controls="recipe-public" id="tab-recipe-public" data-tab-target="recipe-public" tabindex="-1">
                <span>02</span><strong>Share publicly</strong><small>Expose an active route</small>
              </button>
              <button type="button" role="tab" aria-selected="false" aria-controls="recipe-webhook" id="tab-recipe-webhook" data-tab-target="recipe-webhook" tabindex="-1">
                <span>03</span><strong>Expose one path</strong><small>Webhooks, not the whole app</small>
              </button>
              <button type="button" role="tab" aria-selected="false" aria-controls="recipe-logs" id="tab-recipe-logs" data-tab-target="recipe-logs" tabindex="-1">
                <span>04</span><strong>Follow traffic</strong><small>Local and public logs</small>
              </button>
              <button type="button" role="tab" aria-selected="false" aria-controls="recipe-inspect" id="tab-recipe-inspect" data-tab-target="recipe-inspect" tabindex="-1">
                <span>05</span><strong>Inspect a request</strong><small>Opt-in capture</small>
              </button>
              <button type="button" role="tab" aria-selected="false" aria-controls="recipe-diagnose" id="tab-recipe-diagnose" data-tab-target="recipe-diagnose" tabindex="-1">
                <span>06</span><strong>Diagnose routes</strong><small>Check active routes</small>
              </button>
            </div>

            <div class="ru-recipe-panel" id="recipe-compose" role="tabpanel" aria-labelledby="tab-recipe-compose" data-tab-panel="recipe-compose">
              <div class="ru-recipe-panel__copy">
                <h3>Put the frontend and API behind one origin.</h3>
                <p>
                  Longest path prefix wins. One HTTPS origin — cookies work across both targets, no local CORS config.
                </p>
                <dl>
                  <div><dt><code>/</code></dt><dd>Frontend on port 5173</dd></div>
                  <div><dt><code>/api</code></dt><dd>API on port 8080</dd></div>
                </dl>
                <a href="/docs/recipes/frontend-plus-api">Frontend + API recipe &rarr;</a>
              </div>
              <div class="ru-code-stack">
                <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="routeup.json"><code>{`{
  "name": "example-app",
  "targets": [
    { "path": "/", "port": 5173 },
    { "path": "/api", "port": 8080 }
  ]
}`}</code></pre>
                <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="terminal"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup serve</span>
<span class="t-label">route:</span>  example-app
<span class="t-label">local:</span>  <span class="t-localurl">https://example-app.localhost</span>
<span class="t-label">targets:</span>
  /        http://localhost:5173
  /api     http://localhost:8080

<span class="t-dim">press Ctrl-C to stop</span></code></pre>
              </div>
            </div>

            <div class="ru-recipe-panel" id="recipe-public" role="tabpanel" aria-labelledby="tab-recipe-public" data-tab-panel="recipe-public" hidden>
              <div class="ru-recipe-panel__copy">
                <h3>Expose an already-running route from a second terminal.</h3>
                <p>
                  <code>routeup expose</code> reuses an active route without restarting your app.
                  The public URL is session-only and reachable by anyone with it.
                </p>
                <a href="/docs/getting-started/exposing-publicly">Public exposure guide &rarr;</a>
              </div>
              <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="terminal 2"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup expose</span>

<span class="t-label">route:</span>   example-app
<span class="t-label">local:</span>   <span class="t-localurl">https://example-app.localhost</span>
<span class="t-label">public:</span>  <span class="t-publicurl">https://example-app.try.routeup.dev</span>
<span class="t-label">expose:</span>  all paths

<span class="t-dim">press Ctrl-C to stop</span></code></pre>
            </div>

            <div class="ru-recipe-panel" id="recipe-webhook" role="tabpanel" aria-labelledby="tab-recipe-webhook" data-tab-panel="recipe-webhook" hidden>
              <div class="ru-recipe-panel__copy">
                <h3>Make the webhook handler public, not the whole app.</h3>
                <p>
                  <code>expose.paths</code> limits what the public server forwards — local traffic still reaches every target.
                  The tunnel opens before your app starts, so <code>ROUTEUP_URL</code> is available at launch.
                </p>
                <a href="/docs/recipes/webhook-development">Webhook recipe &rarr;</a>
              </div>
              <div class="ru-code-stack">
                <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="routeup.json"><code>{`{
  "name": "example-app",
  "port": 8080,
  "expose": {
    "enabled": true,
    "paths": ["/api/webhooks/*"]
  }
}`}</code></pre>
                <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="terminal (runner mode)"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup</span>
<span class="t-label">route:</span>   example-app
<span class="t-label">local:</span>   <span class="t-localurl">https://example-app.localhost</span>
<span class="t-label">public:</span>  <span class="t-publicurl">https://example-app.try.routeup.dev</span>
<span class="t-label">targets:</span>
  /        http://localhost:8080</code></pre>
              </div>
            </div>

            <div class="ru-recipe-panel" id="recipe-logs" role="tabpanel" aria-labelledby="tab-recipe-logs" data-tab-panel="recipe-logs" hidden>
              <div class="ru-recipe-panel__copy">
                <h3>Follow local and public requests in one stream.</h3>
                <p>
                  Source, method, path, status, duration, request ID. Headers and bodies not retained unless capture is on.
                </p>
                <a href="/docs/cli-reference/logs">Logs reference &rarr;</a>
              </div>
              <pre translate="no" class="ru-terminal ru-terminal--flat ru-terminal--wide" data-title="terminal"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup logs example-app --follow</span>

<span class="t-dim">TIME      SOURCE  ROUTE        METHOD  PATH                  STATUS  DURATION  ID</span>
14:02:01  local   example-app  GET     /api/users            <span class="t-ok">200</span>     12ms      req_Kx4mT9pL2aQ7vN6cR
14:02:03  public  example-app  POST    /api/webhooks/stripe  <span class="t-ok">204</span>     8ms       req_Jz6nR2wL8cP4sD9h</code></pre>
            </div>

            <div class="ru-recipe-panel" id="recipe-inspect" role="tabpanel" aria-labelledby="tab-recipe-inspect" data-tab-panel="recipe-inspect" hidden>
              <div class="ru-recipe-panel__copy">
                <h3>Capture deliberately, redact secrets, then inspect.</h3>
                <p>
                  Off by default. Enable per route, list headers to redact. Held in-memory, cleared on restart.
                </p>
                <a href="/docs/cli-reference/inspect">Inspect reference &rarr;</a>
              </div>
              <div class="ru-code-stack">
                <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="routeup.json"><code>{`{
  "capture": {
    "request": true,
    "response": true,
    "redact_headers": [
      "authorization",
      "cookie",
      "x-webhook-signature"
    ]
  }
}`}</code></pre>
                <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="terminal"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup inspect req_Jz6nR2wL8cP4sD9h</span>

Request req_Jz6nR2wL8cP4sD9h

<span class="t-dim">Metadata
--------</span>
Source: public
Route: example-app
Status: 204
Method: POST
Path: /api/webhooks/stripe

<span class="t-dim">Request
-------</span>
Capture: complete
Body bytes: 256
Redacted: authorization, x-webhook-signature

<span class="t-dim">Response
--------</span>
Capture: complete
Body bytes: 0</code></pre>
              </div>
            </div>

            <div class="ru-recipe-panel" id="recipe-diagnose" role="tabpanel" aria-labelledby="tab-recipe-diagnose" data-tab-panel="recipe-diagnose" hidden>
              <div class="ru-recipe-panel__copy">
                <h3>See what is active before changing anything.</h3>
                <p>
                  <code>routeup routes</code> lists active names, targets, owner PIDs, and working directories.
                  <code>routeup doctor</code> checks the CA, trust store, and agent.
                </p>
                <a href="/docs/cli-reference/routes">Routes reference &rarr;</a>
              </div>
              <pre translate="no" class="ru-terminal ru-terminal--flat ru-terminal--wide" data-title="terminal"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup routes</span>
<span class="t-dim">NAME          TARGETS  PUBLIC  PATHS  PID    AGE  CWD</span>
example-app   /:3000   -       -      48172  5m   ~/code/example-app

<span class="t-prompt">$</span> <span class="t-cmd">routeup doctor</span>
  <span class="t-ok">[ok]</span>   local CA
  <span class="t-ok">[ok]</span>   system trust store
  <span class="t-ok">[ok]</span>   port 443
  <span class="t-ok">[ok]</span>   agent</code></pre>
            </div>
          </div>
        </section>

        {/* ── INSTALL ── */}
        <section class="ru-section ru-section--split" id="install">
          <header class="ru-section__intro">
            <h2>Trust the local CA once.</h2>
            <p>
              Install the single routeup binary, then run setup. It creates a local CA,
              trusts it in your OS, prepares port 443, and starts the local agent.
            </p>
          </header>

          <div class="ru-install" data-tabs>
            <div class="ru-tabs" role="tablist" aria-label="Install method">
              <button type="button" role="tab" aria-selected="true" aria-controls="install-brew" id="tab-install-brew" data-tab-target="install-brew">Homebrew</button>
              <button type="button" role="tab" aria-selected="false" aria-controls="install-curl" id="tab-install-curl" data-tab-target="install-curl" tabindex="-1">Install script</button>
              <button type="button" role="tab" aria-selected="false" aria-controls="install-release" id="tab-install-release" data-tab-target="install-release" tabindex="-1">Release</button>
            </div>

            <div class="ru-tab-panel" id="install-brew" role="tabpanel" aria-labelledby="tab-install-brew" data-tab-panel="install-brew">
              <div class="ru-code-wrap">
                <pre translate="no" class="ru-terminal ru-terminal--flat"><code><span class="t-prompt">$</span> <span class="t-cmd">brew install mukul-mehta/tap/routeup</span>
<span class="t-prompt">$</span> <span class="t-cmd">routeup setup</span></code></pre>
                <button class="ru-copy" type="button" data-copy="brew install mukul-mehta/tap/routeup" aria-label="Copy Homebrew install command">Copy install</button>
              </div>
            </div>

            <div class="ru-tab-panel" id="install-curl" role="tabpanel" aria-labelledby="tab-install-curl" data-tab-panel="install-curl" hidden>
              <div class="ru-code-wrap">
                <pre translate="no" class="ru-terminal ru-terminal--flat"><code><span class="t-prompt">$</span> <span class="t-cmd">curl -fsSL https://get.routeup.dev | sh</span>
<span class="t-prompt">$</span> <span class="t-cmd">routeup setup</span></code></pre>
                <button class="ru-copy" type="button" data-copy="curl -fsSL https://get.routeup.dev | sh" aria-label="Copy install script command">Copy install</button>
              </div>
            </div>

            <div class="ru-tab-panel ru-release" id="install-release" role="tabpanel" aria-labelledby="tab-install-release" data-tab-panel="install-release" hidden>
              <p>Download a checksum-verified macOS or Linux binary from GitHub.</p>
              <a href="https://github.com/mukul-mehta/routeup/releases" rel="noopener noreferrer">Open releases &nearr;</a>
            </div>

            <pre translate="no" class="ru-terminal ru-terminal--flat" data-title="terminal"><code><span class="t-prompt">$</span> <span class="t-cmd">routeup setup</span>
<span class="t-dim">Public server URL [https://edge.routeup.dev]: </span>
<span class="t-dim">Token (blank to keep current): </span>
certificate authority: already set up
trusting the certificate system-wide (asks for your password)...
certificate: <span class="t-ok">trusted</span>
setting up port 443 (asks for your password)...
port 443: <span class="t-ok">ready</span>
server: <span class="t-ok">saved</span> (https://edge.routeup.dev)
agent: <span class="t-ok">already running</span></code></pre>
            <a href="/docs/getting-started/install" class="ru-install-link">Installation details &rarr;</a>
          </div>
        </section>

        {/* ── PROBLEM STRIP ── */}
        <section class="ru-problems" aria-label="Why routeup exists">
          <div class="ru-problems__head">Why this exists</div>
          <ul>
            <li>
              <span class="ru-problem__tag">[ports]</span>
              <p>Three services. Three ports to remember. One changes and the browser goes to the wrong app.</p>
            </li>
            <li>
              <span class="ru-problem__tag">[tls]</span>
              <p>Secure cookies and HTTPS-only SDKs behave differently on <code>http://localhost</code>. The bugs show up after deploy.</p>
            </li>
            <li>
              <span class="ru-problem__tag">[tunnel urls]</span>
              <p>Every ngrok session hands you a new random URL. Re-register it with Stripe or GitHub every morning.</p>
            </li>
            <li>
              <span class="ru-problem__tag">[callbacks]</span>
              <p>OAuth providers want one redirect URI. Yours includes <code>localhost:3000</code> and breaks when the port changes.</p>
            </li>
          </ul>
        </section>

        {/* ── HOW IT WORKS ── */}
        <section class="ru-section" id="how">
          <header class="ru-head ru-head--narrow">
            <h2>The same local target, two paths to reach it.</h2>
          </header>

          <div class="ru-flows">
            <article class="ru-flow">
              <div class="ru-flow__header"><span class="ru-status ru-status--local"></span><strong>Local request</strong><small>No server contact</small></div>
              <ol>
                <li><span>Browser</span><code>https://example-app.localhost</code></li>
                <li><span>Local agent</span><small>terminates trusted TLS</small></li>
                <li><span>Your app</span><code>127.0.0.1:3000</code></li>
              </ol>
            </article>
            <article class="ru-flow ru-flow--public">
              <div class="ru-flow__header"><span class="ru-status ru-status--public"></span><strong>Public request</strong><small>Only when exposed</small></div>
              <ol>
                <li><span>Internet client</span><code>https://example-app.try.routeup.dev</code></li>
                <li><span>Routeup server</span><small>terminates public TLS</small></li>
                <li><span>Outbound tunnel</span><small>encrypted back to your agent</small></li>
                <li><span>Your app</span><code>127.0.0.1:3000</code></li>
              </ol>
            </article>
          </div>
        </section>

        {/* ── BOUNDARIES ── */}
        <section class="ru-section ru-section--split ru-section--last">
          <header class="ru-section__intro">
            <p class="ru-kicker">The boundaries</p>
            <h2>The full stack in one Go binary.</h2>
            <p>
              CLI, local agent, and server. MIT licensed. Zero telemetry. Local use
              works offline. Public exposure is optional and points at the hosted server
              or your own.
            </p>
            <div class="ru-ctas">
              <a href="/docs" class="ru-btn ru-btn--primary">Read the docs</a>
              <a href="https://github.com/mukul-mehta/routeup" rel="noopener noreferrer" class="ru-btn ru-btn--ghost">View source &nearr;</a>
            </div>
          </header>
          <ul class="ru-boundaries">
            <li><strong>Local means local</strong><span>No account, token, DNS, or server request for <code>*.localhost</code>.</span></li>
            <li><strong>Capture is opt-in</strong><span>Request bodies are not retained unless a route explicitly enables capture.</span></li>
            <li><strong>Foreground owns lifetime</strong><span>Ctrl-C releases the route, child process, and tunnel owned by that command.</span></li>
            <li><strong>MIT licensed</strong><span>Zero telemetry, self-hostable server, documented operations.</span></li>
          </ul>
        </section>

      </main>

      <footer class="ru-footer">
        <div class="ru-footer__top">
          <a href="/" class="ru-brand">
            <img src="/favicon.svg" alt="" width="22" height="22" class="ru-brand__mark" />
            <span>routeup</span>
          </a>
          <nav aria-label="Footer">
            <a href="/docs">Docs</a>
            <a href="/docs/getting-started/first-route">First route</a>
            <a href="/docs/self-hosting/running-the-server">Self-host</a>
            <a href="https://github.com/mukul-mehta/routeup" rel="noopener noreferrer">GitHub</a>
            <a href="/llms.txt">llms.txt</a>
          </nav>
        </div>
        <p>&copy; 2026 routeup contributors. MIT licensed. Zero telemetry.</p>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var live = document.querySelector('.ru-sr-live');

        document.querySelectorAll('[data-tabs]').forEach(function (group) {
          var tabs = Array.from(group.querySelectorAll('[role="tab"]'));
          var panels = Array.from(group.querySelectorAll('[role="tabpanel"]'));

          function activate(tab, moveFocus, updateHash) {
            var target = tab.getAttribute('data-tab-target');
            tabs.forEach(function (item) {
              var active = item === tab;
              item.setAttribute('aria-selected', active ? 'true' : 'false');
              item.setAttribute('tabindex', active ? '0' : '-1');
            });
            panels.forEach(function (panel) {
              panel.hidden = panel.getAttribute('data-tab-panel') !== target;
            });
            if (moveFocus) tab.focus();
            if (updateHash && target && !target.startsWith('install-') && !target.startsWith('recipe-')) {
              history.replaceState(null, '', '#' + target);
            }
          }

          tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
              activate(tab, false, true);
            });
            tab.addEventListener('keydown', function (event) {
              var index = tabs.indexOf(tab);
              var next = index;
              if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
              else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
              else if (event.key === 'Home') next = 0;
              else if (event.key === 'End') next = tabs.length - 1;
              else return;
              event.preventDefault();
              activate(tabs[next], true, true);
            });
          });

          var hash = window.location.hash.slice(1);
          var requested = tabs.find(function (tab) {
            return tab.getAttribute('data-tab-target') === hash;
          });
          if (requested) activate(requested, false, false);
        });

        document.querySelectorAll('.ru-copy').forEach(function (button) {
          button.addEventListener('click', async function () {
            var original = button.textContent;
            try {
              await navigator.clipboard.writeText(button.getAttribute('data-copy') || '');
              button.textContent = 'Copied';
              button.classList.add('is-copied');
              if (live) live.textContent = 'Command copied to clipboard';
            } catch (_error) {
              button.textContent = 'Copy failed';
              if (live) live.textContent = 'Could not copy command';
            }
            window.setTimeout(function () {
              button.textContent = original;
              button.classList.remove('is-copied');
            }, 1600);
          });
        });
      })();
    </script>

    <style is:global>
      :root {
        --paper: #e9e3d2;
        --paper-deep: #d9d0b8;
        --surface: #fffaf0;
        --surface-cool: #edf4ee;
        --ink: #1b1812;
        --ink-soft: #464034;
        --ink-faint: #595247;
        --rule: rgba(27, 24, 18, 0.17);
        --teal: #087f79;
        --teal-dark: #075d59;
        --public: #a44a16;
        --named: #3d6b62;
        --terminal: #171512;
        --terminal-bar: #211e19;
        --terminal-text: #d8d0ba;
        --ok: #9dc7a2;
        --sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --mono: ui-monospace, "SFMono-Regular", "Cascadia Code", "Roboto Mono", Menlo, Consolas, monospace;
        --max: 1180px;
        --gutter: clamp(1.1rem, 4vw, 3.2rem);
        --fast: 140ms;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        color-scheme: light;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a { color: inherit; text-decoration: none; }
      button { color: inherit; }
      code {
        padding: 0.08em 0.3em;
        border: 1px solid var(--rule);
        background: rgba(255, 250, 240, 0.7);
        font-family: var(--mono);
        font-size: 0.9em;
        font-weight: 650;
      }
      strong { font-weight: 750; }
      ::selection { background: var(--teal); color: var(--surface); }
      :focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; }
      [hidden] { display: none !important; }

      .ru-sr-live, .ru-skip {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .ru-skip:focus-visible {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        width: auto;
        height: auto;
        margin: 0;
        padding: 0.55rem 0.85rem;
        overflow: visible;
        clip: auto;
        background: var(--surface);
        border: 2px solid var(--ink);
        font-family: var(--mono);
        font-weight: 700;
      }

      .ru-page { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }

      /* ── NAV ── */
      .ru-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.15rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .ru-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--mono);
        font-size: 0.95rem;
        font-weight: 800;
      }
      .ru-brand__mark { display: block; image-rendering: pixelated; }
      .ru-nav__links { display: flex; align-items: center; gap: clamp(0.8rem, 2.4vw, 1.8rem); font-family: var(--mono); font-size: 0.78rem; font-weight: 650; }
      .ru-nav__links a { padding: 0.25rem 0; color: var(--ink-soft); transition: color var(--fast) var(--ease); }
      .ru-nav__links a:hover { color: var(--teal-dark); }
      .ru-nav__gh { font-weight: 800; }

      /* ── HERO ── */
      .ru-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
        gap: clamp(2.5rem, 6vw, 5rem);
        align-items: center;
        padding: clamp(2rem, 4vw, 3.5rem) 0 0;
      }
      .ru-kicker, .ru-panel-tag {
        margin: 0 0 1rem;
        color: var(--teal-dark);
        font-family: var(--mono);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .ru-hero h1, .ru-head h2, .ru-section__intro h2 {
        margin: 0;
        font-family: var(--mono);
        font-weight: 850;
        letter-spacing: -0.03em;
        line-height: 1.1;
        text-wrap: balance;
      }
      .ru-hero h1 { max-width: 22ch; font-size: clamp(2.1rem, 3.6vw, 3.1rem); }
      .ru-hero__lede { max-width: 59ch; margin: 1.5rem 0 1.8rem; color: var(--ink-soft); font-size: clamp(0.98rem, 1.4vw, 1.08rem); line-height: 1.72; }
      .ru-hero__lede code { color: var(--teal-dark); }
      .ru-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .ru-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.7rem;
        padding: 0.6rem 1rem;
        border: 2px solid var(--ink);
        font-family: var(--mono);
        font-size: 0.8rem;
        font-weight: 800;
        box-shadow: 3px 3px 0 var(--ink);
        transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
      }
      .ru-btn--primary { background: var(--teal-dark); color: var(--surface); }
      .ru-btn--ghost { background: var(--surface); }
      .ru-btn:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--ink); }
      .ru-btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--ink); }
      .ru-proof { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem 1.4rem; padding: 0; margin: 1.5rem 0 0; list-style: none; color: var(--ink-faint); font-family: var(--mono); font-size: 0.72rem; font-weight: 650; }
      .ru-proof li::before { content: ""; display: inline-block; width: 0.42rem; height: 0.42rem; margin-right: 0.5rem; background: var(--teal); vertical-align: 0.08rem; }

      /* ── HERO DEMO ── */
      .ru-hero__demo { min-width: 0; }
      .ru-hero-terminal { box-shadow: 8px 8px 0 var(--ink); }

      /* ── PROBLEM STRIP ── */
      .ru-problems {
        border-top: 1px solid var(--rule);
        background: var(--surface);
      }
      .ru-problems__head {
        padding: 1rem 1.5rem 0.6rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 800;
        color: var(--teal-dark);
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }
      .ru-problems ul {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        padding: 1px;
        margin: 0;
        list-style: none;
        background: var(--rule);
      }
      .ru-problems li {
        padding: 1.3rem 1.5rem 1.5rem;
        background: var(--surface);
      }
      .ru-problem__tag {
        display: block;
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 800;
        color: var(--teal-dark);
        letter-spacing: 0.05em;
        margin-bottom: 0.55rem;
      }
      .ru-problems p {
        margin: 0;
        font-size: 0.88rem;
        color: var(--ink-soft);
        line-height: 1.55;
      }

      /* ── SECTIONS ── */
      .ru-section { padding: clamp(2.5rem, 5vw, 4.5rem) 0; border-top: 1px solid var(--rule); scroll-margin-top: 2rem; }
      .ru-section--last { border-bottom: 1px solid var(--rule); }
      .ru-section--split { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(2.5rem, 7vw, 6rem); align-items: start; }
      .ru-section__intro { position: sticky; top: 2rem; }
      .ru-section__intro h2, .ru-head h2 { font-size: clamp(1.6rem, 2.5vw, 2.2rem); }
      .ru-section__intro > p:not(.ru-kicker), .ru-head > p:not(.ru-kicker) { max-width: 69ch; margin: 1.1rem 0 0; color: var(--ink-soft); }
      .ru-head { margin-bottom: 2rem; }
      .ru-head--narrow { max-width: 780px; }
      .ru-aside, .ru-warning {
        padding: 0.85rem 1rem;
        border-left: 3px solid var(--public);
        background: rgba(255, 250, 240, 0.56);
        color: var(--ink-soft);
        font-size: 0.88rem;
        margin-top: 1rem;
      }
      .ru-section__intro .ru-ctas { margin-top: 1.8rem; }

      /* ── TERMINAL ── */
      .ru-terminal {
        position: relative;
        margin: 0;
        min-width: 0;
        padding: 3.4rem 1.35rem 1.25rem;
        overflow-x: auto;
        border: 2px solid var(--ink);
        background: var(--terminal);
        color: var(--terminal-text);
        font-family: var(--mono);
        font-size: clamp(0.76rem, 1.25vw, 0.86rem);
        line-height: 1.75;
        tab-size: 2;
      }
      .ru-terminal::before {
        content: attr(data-title);
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2.45rem;
        padding-left: 4.2rem;
        border-bottom: 1px solid #383229;
        background: var(--terminal-bar);
        color: #9c9282;
        font-size: 0.66rem;
        line-height: 2.45rem;
        text-align: center;
      }
      .ru-terminal::after {
        content: "";
        position: absolute;
        top: 0.84rem;
        left: 1rem;
        width: 0.68rem;
        height: 0.68rem;
        border-radius: 50%;
        background: #ff5f57;
        box-shadow: 1rem 0 0 #ffbd2e, 2rem 0 0 #28c840;
      }
      .ru-terminal--flat { box-shadow: none; }
      .ru-terminal--wide { font-size: clamp(0.7rem, 1.05vw, 0.8rem); }
      .ru-terminal code { padding: 0; border: 0; background: transparent; color: inherit; font: inherit; }
      .t-prompt { color: #9c9282; user-select: none; }
      .t-cmd { color: #f4edda; font-weight: 700; }
      .t-label { color: #bcb19e; }
      .t-dim { color: #a79d8d; }
      .t-localurl { color: #b8d2aa; }
      .t-publicurl { color: #66cfaa; font-weight: 750; }
      .t-ok { color: var(--ok); font-weight: 800; }
      .ru-code-wrap { position: relative; }
      .ru-copy {
        position: absolute;
        z-index: 2;
        top: 0.65rem;
        right: 0.7rem;
        padding: 0.32rem 0.52rem;
        border: 1px solid #514a40;
        background: #2d2923;
        color: #d8d0ba;
        font-family: var(--mono);
        font-size: 0.65rem;
        font-weight: 750;
        cursor: pointer;
      }
      .ru-copy:hover, .ru-copy.is-copied { background: var(--teal-dark); color: white; }

      /* ── INSTALL TABS ── */
      .ru-tabs { display: flex; gap: 0.45rem; margin-bottom: 0.65rem; }
      .ru-tabs button {
        padding: 0.48rem 0.75rem;
        border: 1px solid var(--ink);
        background: transparent;
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 750;
        cursor: pointer;
      }
      .ru-tabs button[aria-selected="true"] { background: var(--ink); color: var(--surface); }
      .ru-release { padding: 1.5rem; border: 2px solid var(--ink); background: var(--surface); }
      .ru-release p { margin: 0 0 0.6rem; }
      .ru-release a, .ru-setup-result a, .ru-recipe-panel a, .ru-install-link { color: var(--teal-dark); font-family: var(--mono); font-size: 0.78rem; font-weight: 800; text-decoration: underline; text-underline-offset: 0.25rem; }
      .ru-setup-result { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem 1.5rem; padding: 1.25rem 1.4rem; border: 1px solid var(--rule); border-top: 0; background: var(--surface); }
      .ru-setup-result > span { grid-row: 1 / 3; color: var(--teal-dark); font-family: var(--mono); font-size: 0.72rem; font-weight: 850; text-transform: uppercase; }
      .ru-setup-result ul { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; padding: 0; margin: 0; list-style: none; font-size: 0.84rem; }
      .ru-setup-result strong { font-family: var(--mono); }

      /* ── RECIPE TABS ── */
      .ru-recipe-panel { display: grid; grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr); gap: clamp(2rem, 5vw, 4.5rem); padding: clamp(1.5rem, 3.5vw, 2.8rem); border: 1px solid var(--rule); border-top: 0; background: var(--surface); }
      .ru-recipe-panel__copy h3 { margin: 0; font-family: var(--mono); font-size: clamp(1.1rem, 2vw, 1.55rem); line-height: 1.28; letter-spacing: -0.02em; }
      .ru-recipe-panel__copy > p:not(.ru-panel-tag) { color: var(--ink-soft); }
      .ru-recipe-panel__copy > a { display: inline-block; margin-top: 0.6rem; }
      .ru-code-stack { display: grid; gap: 1rem; min-width: 0; align-content: start; }

      .ru-recipe-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; padding: 1px; background: var(--rule); border: 1px solid var(--rule); }
      .ru-recipe-tabs button { display: grid; grid-template-columns: auto 1fr; gap: 0.1rem 0.75rem; min-height: 6.2rem; padding: 1rem 1.1rem; border: 0; background: var(--surface); text-align: left; cursor: pointer; transition: background-color var(--fast) var(--ease); }
      .ru-recipe-tabs button:hover { background: var(--surface-cool); }
      .ru-recipe-tabs button[aria-selected="true"] { background: var(--ink); color: var(--surface); }
      .ru-recipe-tabs button > span { grid-row: 1 / 3; color: var(--teal); font-family: var(--mono); font-size: 0.68rem; font-weight: 850; }
      .ru-recipe-tabs button[aria-selected="true"] > span { color: #62c5bc; }
      .ru-recipe-tabs strong { align-self: end; font-family: var(--mono); font-size: 0.86rem; }
      .ru-recipe-tabs small { color: var(--ink-faint); font-size: 0.75rem; }
      .ru-recipe-tabs button[aria-selected="true"] small { color: #b9b2a2; }
      .ru-recipe-panel { border-top: 0; }
      .ru-recipe-panel dl { margin: 1.1rem 0; }
      .ru-recipe-panel dl div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.8rem; padding: 0.45rem 0; border-bottom: 1px solid var(--rule); }
      .ru-recipe-panel dt, .ru-recipe-panel dd { margin: 0; font-size: 0.86rem; }
      .ru-recipe-panel dd { color: var(--ink-soft); }

      /* ── HOW IT WORKS ── */
      .ru-flows { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; }
      .ru-flow { padding: clamp(1.2rem, 2.8vw, 1.9rem); border: 1px solid var(--rule); background: var(--surface); }
      .ru-flow--public { background: #f7eee3; }
      .ru-flow__header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.65rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--rule); }
      .ru-flow__header strong { font-family: var(--mono); }
      .ru-flow__header small { color: var(--ink-faint); }
      .ru-status { width: 0.6rem; height: 0.6rem; }
      .ru-status--local { background: var(--teal); }
      .ru-status--public { background: var(--public); }
      .ru-flow ol { padding: 0; margin: 1.2rem 0 0; list-style: none; counter-reset: flow; }
      .ru-flow li { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem; padding: 0 0 1.55rem 2rem; counter-increment: flow; }
      .ru-flow li:last-child { padding-bottom: 0; }
      .ru-flow li::before { content: counter(flow); position: absolute; left: 0; top: 0.05rem; display: grid; place-items: center; width: 1.05rem; height: 1.05rem; background: var(--ink); color: var(--surface); font-family: var(--mono); font-size: 0.58rem; font-weight: 850; }
      .ru-flow li:not(:last-child)::after { content: ""; position: absolute; left: 0.49rem; top: 1.15rem; bottom: 0.1rem; width: 1px; background: var(--ink); opacity: 0.3; }
      .ru-flow li > span { font-family: var(--mono); font-size: 0.84rem; font-weight: 800; }
      .ru-flow li > code, .ru-flow li > small { grid-column: 2; color: var(--ink-faint); font-size: 0.72rem; }

      /* ── BOUNDARIES ── */
      .ru-boundaries { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding: 1px; margin: 0; background: var(--rule); border: 1px solid var(--rule); list-style: none; }
      .ru-boundaries li { padding: 1.35rem; background: var(--surface); }
      .ru-boundaries strong, .ru-boundaries span { display: block; }
      .ru-boundaries strong { margin-bottom: 0.45rem; font-family: var(--mono); font-size: 0.86rem; }
      .ru-boundaries span { color: var(--ink-soft); font-size: 0.85rem; }

      /* ── FOOTER ── */
      .ru-footer { padding: 2.2rem 0 3rem; }
      .ru-footer__top { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; }
      .ru-footer nav { display: flex; flex-wrap: wrap; gap: 0.8rem 1.4rem; font-family: var(--mono); font-size: 0.72rem; font-weight: 650; }
      .ru-footer nav a:hover { color: var(--teal-dark); }
      .ru-footer > p { margin: 1rem 0 0; color: var(--ink-faint); font-family: var(--mono); font-size: 0.68rem; }

      /* ── RESPONSIVE ── */
      @media (max-width: 920px) {
        .ru-hero { grid-template-columns: 1fr; }
        .ru-hero h1 { max-width: 30ch; }
        .ru-section--split { grid-template-columns: 1fr; }
        .ru-section__intro { position: static; }
        .ru-recipe-panel { grid-template-columns: 1fr; }
        .ru-flows { grid-template-columns: 1fr; }
        .ru-problems ul { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 700px) {
        body { font-size: 15px; }
        .ru-nav { align-items: flex-start; }
        .ru-nav__links { justify-content: flex-end; gap: 0.5rem 0.9rem; }
        .ru-nav__links a:nth-child(3) { display: none; }
        .ru-recipe-tabs { grid-template-columns: 1fr 1fr; }
        .ru-boundaries { grid-template-columns: 1fr; }
        .ru-setup-result { grid-template-columns: 1fr; }
        .ru-setup-result > span { grid-row: auto; }
        .ru-setup-result ul { display: grid; }
        .ru-flow__header { grid-template-columns: auto 1fr; }
        .ru-flow__header small { grid-column: 2; }
        .ru-problems ul { grid-template-columns: 1fr; }
      }

      @media (max-width: 480px) {
        .ru-page { padding: 0 1rem; }
        .ru-nav { display: block; }
        .ru-nav__links { justify-content: flex-start; margin-top: 0.9rem; }
        .ru-nav__links a:nth-child(1), .ru-nav__links a:nth-child(3) { display: none; }
        .ru-hero { padding-top: 2rem; }
        .ru-proof { grid-template-columns: 1fr; }
        .ru-recipe-tabs { grid-template-columns: 1fr; }
        .ru-recipe-tabs button { min-height: 5rem; }
        .ru-tabs { overflow-x: auto; padding-bottom: 0.2rem; }
        .ru-tabs button { flex: 0 0 auto; }
        .ru-recipe-panel { padding: 1.1rem; }
        .ru-terminal { font-size: 0.74rem; }
        .ru-footer__top { align-items: flex-start; flex-direction: column; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: 1ms !important; }
      }
    </style>
  </body>
</html>
