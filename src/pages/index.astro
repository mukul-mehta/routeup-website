      }
      .ru-terminal--sm[data-title]::before { line-height: 2.25rem; }
      .ru-terminal--install { margin: 0; }
      .ru-terminal code { font-family: var(--term); font-size: inherit; padding: 0; background: none; border: 0; font-weight: 500; color: inherit; }
      .t-prompt    { color: #4a4038; user-select: none; }
      .t-cmd       { color: #e8e2d0; font-weight: 600; }
      .t-label     { color: #c8c0a8; }
      .t-dim       { color: #8a7d70; }
      .t-localurl  { color: #b4c49e; }
      .t-publicurl { color: #5ec8a0; font-weight: 700; }
      .t-cursor { display: inline-block; margin-left: 0.1ch; color: #e8e2d0; user-select: none; animation: blink 1s steps(1, end) infinite; }
      @keyframes blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

      /* ───────────────────────────── BUTTONS ─────────────────────────────── */
      .ru-ctas { display: flex; gap: 0.7rem; flex-wrap: wrap; }
      .ru-ctas--end { margin-top: 1.8rem; }
      .ru-btn {
        display: inline-flex;
        align-items: center;
