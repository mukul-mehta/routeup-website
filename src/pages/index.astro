    <script is:inline>
      (function () {
        var live = document.querySelector('.ru-sr-live');

        function track(eventName, data) {
          if (window.umami) window.umami.track(eventName, data);
        }

        /* ── Copy install commands ─────────────────────────────────────── */
        document.querySelectorAll('[data-copy]').forEach(function (button) {
          var timer;
          button.addEventListener('click', async function () {
            var action = button.querySelector('.ru-install-command__action');
            try {
              await navigator.clipboard.writeText(button.getAttribute('data-copy') || '');
              button.classList.add('is-copied');
              if (action) action.textContent = 'Copied';
              if (live) live.textContent = 'Command copied to clipboard';
              track('install_copy', { method: button.getAttribute('data-install-method') || 'unknown' });
            } catch (_error) {
              if (action) action.textContent = 'Try again';
              if (live) live.textContent = 'Could not copy command';
            }
            clearTimeout(timer);
            timer = setTimeout(function () {
              button.classList.remove('is-copied');
              if (action) action.textContent = 'Copy';
            }, 1500);
          });
        });

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ── Run mode switcher ─────────────────────────────────────────── */
        var modeTabs = Array.prototype.slice.call(document.querySelectorAll('.ru-mode-tab'));
        var modePanels = Array.prototype.slice.call(document.querySelectorAll('.ru-mode-panel'));

        function activateMode(tab, moveFocus) {
          var target = tab.getAttribute('aria-controls');
          modeTabs.forEach(function (item) {
            var active = item === tab;
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            item.setAttribute('tabindex', active ? '0' : '-1');
          });
          modePanels.forEach(function (panel) { panel.hidden = panel.id !== target; });
          if (moveFocus) tab.focus();
        }

        modeTabs.forEach(function (tab) {
          tab.addEventListener('click', function () { activateMode(tab, false); });
          tab.addEventListener('keydown', function (event) {
            var index = modeTabs.indexOf(tab);
            var next = index;
            if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % modeTabs.length;
            else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + modeTabs.length) % modeTabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = modeTabs.length - 1;
            else return;
            event.preventDefault();
            activateMode(modeTabs[next], true);
          });
        });

        /* ── Recipe master–detail ──────────────────────────────────────── */
        var detail = document.querySelector('.ru-detail');
        var recipeList = document.querySelector('.ru-rlist');
        var recipePrev = document.querySelector('[data-recipe-prev]');
        var recipeNext = document.querySelector('[data-recipe-next]');
        var recipeCount = document.querySelector('[data-recipe-count]');
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.ru-rrow'));
        var panels = Array.prototype.slice.call(document.querySelectorAll('.ru-dpanel'));
        var swap = 0;

        function syncRecipeHeightLimit() {
          if (!detail || !recipeList) return;
          var listHeight = recipeList.getBoundingClientRect().height;
          var limit = window.matchMedia('(max-width: 1080px)').matches
            ? 360
            : listHeight;
          detail.style.setProperty('--recipe-max-height', Math.round(limit) + 'px');
        }

        function syncRecipeControls(tab) {
          var index = tabs.indexOf(tab);
          if (recipeCount) recipeCount.textContent = String(index + 1) + ' / ' + String(tabs.length);
          if (recipePrev) recipePrev.disabled = index <= 0;
          if (recipeNext) recipeNext.disabled = index >= tabs.length - 1;
        }

        function centerRecipeTab(tab) {
          if (!recipeList || !window.matchMedia('(max-width: 1080px)').matches) return;
          var left = tab.offsetLeft - (recipeList.clientWidth - tab.offsetWidth) / 2;
          recipeList.scrollTo({ left: left, behavior: reduceMotion ? 'auto' : 'smooth' });
        }

        function activate(tab, moveFocus, updateURL, recordSelection) {
          var target = tab.getAttribute('aria-controls');
          tabs.forEach(function (item) {
            var active = item === tab;
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            item.setAttribute('tabindex', active ? '0' : '-1');
          });
          panels.forEach(function (panel) {
            panel.hidden = panel.id !== target;
          });
          // Alternate two identical keyframes so the fade restarts every click.
          swap++;
          detail.classList.toggle('swap-a', swap % 2 === 1);
          detail.classList.toggle('swap-b', swap % 2 === 0);
          if (updateURL) {
            var hash = '#' + tab.getAttribute('data-recipe-hash');
            if (window.location.hash !== hash) history.pushState(null, '', hash);
          }
          syncRecipeControls(tab);
          if (moveFocus || updateURL) centerRecipeTab(tab);
          if (moveFocus) tab.focus();
          if (recordSelection) {
            track('recipe_select', { recipe: tab.getAttribute('data-recipe-hash') || 'unknown' });
          }
        }

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () { activate(tab, false, true, true); });
          tab.addEventListener('keydown', function (event) {
            var index = tabs.indexOf(tab);
            var next = index;
            if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
            else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
