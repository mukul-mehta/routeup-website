      /* ────────────────────────────── GRIDS ─────────────────────────────── */
      .ru-grid { list-style: none; padding: 0; margin: 0; }
      .ru-grid > li { min-width: 0; }
      .ru-grid--problems { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.8rem 2.8rem; }
      .ru-grid--problems > li { position: relative; padding-left: 1rem; }
      .ru-grid--problems > li::before {
