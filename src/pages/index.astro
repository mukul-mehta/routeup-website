    <script is:inline>
      // Install method tabs and copy actions.
      (function () {
        var tabs = Array.from(document.querySelectorAll('.ru-tab'));
        var panels = Array.from(document.querySelectorAll('.ru-install__panel'));

        function activate(tab, moveFocus) {
          var target = tab.getAttribute('data-tab');
          tabs.forEach(function (item) {
            var active = item === tab;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            item.setAttribute('tabindex', active ? '0' : '-1');
          });
          panels.forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-tab-panel') !== target;
          });
          if (moveFocus) tab.focus();
        }

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            activate(tab, false);
          });
          tab.addEventListener('keydown', function (event) {
            var index = tabs.indexOf(tab);
            var next = index;
            if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
            else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = tabs.length - 1;
            else return;
            event.preventDefault();
            activate(tabs[next], true);
          });
        });

        document.querySelectorAll('.ru-copy').forEach(function (button) {
          button.addEventListener('click', async function () {
            var origLabel = button.getAttribute('aria-label');
            try {
              await navigator.clipboard.writeText(button.getAttribute('data-copy'));
              button.textContent = 'Copied';
              button.setAttribute('aria-label', 'Copied to clipboard');
              button.classList.add('is-copied');
              window.setTimeout(function () {
                button.textContent = 'Copy';
                button.setAttribute('aria-label', origLabel);
                button.classList.remove('is-copied');
              }, 1600);
            } catch (_error) {
              button.textContent = 'Copy failed';
              button.setAttribute('aria-label', 'Copy failed');
              window.setTimeout(function () {
                button.textContent = 'Copy';
                button.setAttribute('aria-label', origLabel);
              }, 1600);
            }
          });
        });
      })();
    </script>

    <script is:inline>
      // Hero terminal typing animation. No-JS fallback: content is in the HTML and visible.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var code = document.getElementById('hero-term-code');
        if (!code || code.dataset.anim) return;
        code.dataset.anim = '1';
        while (code.firstChild) code.removeChild(code.firstChild);

        var seq = [
          { type: 'cmd',   text: 'brew install mukul-mehta/tap/routeup' },
          { type: 'pause', ms: 350 },
          { type: 'cmd',   text: 'routeup setup' },
          { type: 'pause', ms: 300 },
          { type: 'blank' },
          { type: 'cmd',   text: 'routeup serve example-app --port 8080 --public' },
          { type: 'pause', ms: 150 },
          { type: 'out', html: '<span class="t-label">route:</span> example-app' },
          { type: 'out', html: '<span class="t-label">local:</span> <span class="t-localurl">https://example-app.localhost</span>' },
          { type: 'out', html: '<span class="t-label">public:</span> <span class="t-publicurl">https://example-app.try.routeup.dev</span>' },
          { type: 'out', html: '<span class="t-label">expose:</span> all paths' },
          { type: 'out', html: '<span class="t-label">targets:</span>' },
          { type: 'out', html: '  /        http://localhost:8080' },
          { type: 'blank' },
          { type: 'out', html: '<span class="t-dim">press Ctrl-C to stop</span><span class="t-cursor" aria-hidden="true">█</span>' },
        ];

        function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

        function appendLine(el) {
          code.appendChild(el);
          code.appendChild(document.createTextNode('\n'));
        }

        async function run() {
          await wait(500);
          for (var i = 0; i < seq.length; i++) {
            var s = seq[i];
            if (s.type === 'pause') {
              await wait(s.ms);
            } else if (s.type === 'blank') {
              code.appendChild(document.createTextNode('\n'));
            } else if (s.type === 'cmd') {
              var line = document.createElement('span');
              var prompt = document.createElement('span');
              prompt.className = 't-prompt';
              prompt.textContent = '$';
              line.appendChild(prompt);
              line.appendChild(document.createTextNode(' '));
              var cmd = document.createElement('span');
              cmd.className = 't-cmd';
              line.appendChild(cmd);
              appendLine(line);
              for (var j = 0; j < s.text.length; j++) {
                cmd.textContent += s.text[j];
                await wait(30 + Math.random() * 25);
              }
            } else if (s.type === 'out') {
              var out = document.createElement('span');
              out.innerHTML = s.html;
              appendLine(out);
              await wait(70);
            }
          }
        }

        run();
      })();
    </script>




    <style is:global>
      :root {
