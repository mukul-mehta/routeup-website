  '@type': 'SoftwareApplication',
  '@id': 'https://routeup.dev/#software',
  name: 'Routeup',
  description:
    'An open-source command-line tool that gives local services stable, trusted HTTPS names and optionally exposes them through a public tunnel.',
  url: 'https://routeup.dev/',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Developer tool',
  operatingSystem: ['macOS', 'Linux'],
  isAccessibleForFree: true,
  downloadUrl: 'https://github.com/mukul-mehta/routeup/releases/latest',
  installUrl: 'https://routeup.dev/docs/getting-started/install/',
  softwareHelp: 'https://routeup.dev/docs/',
  license: 'https://github.com/mukul-mehta/routeup/blob/main/LICENSE',
  sameAs: ['https://github.com/mukul-mehta/routeup'],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
}).replace(/</g, '\\u003c');

