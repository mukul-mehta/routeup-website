      .ru-workflow-tab { display: grid; grid-template-columns: 1fr auto; gap: 0.35rem 1.5rem; padding: 1.3rem 1.4rem; border: 0; background: var(--surface); text-align: left; cursor: pointer; }
      .ru-workflow-tab[aria-selected="true"] { background: var(--teal-dark); color: var(--surface); }
      .ru-choice__label { font-family: var(--mono); font-size: clamp(0.9rem, 1.5vw, 1.1rem); font-weight: 850; }
      .ru-choice__command { align-self: center; grid-row: 1 / 3; grid-column: 2; padding: 0.28rem 0.48rem; border: 1px solid currentColor; font-family: var(--mono); font-size: 0.7rem; font-weight: 750; }
      .ru-choice__copy { color: var(--ink-faint); font-size: 0.84rem; }
      .ru-workflow-tab[aria-selected="true"] .ru-choice__copy { color: rgba(255, 250, 240, 0.74); }
      .ru-workflow-panel, .ru-recipe-panel { display: grid; grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr); gap: clamp(2rem, 5vw, 4.5rem); padding: clamp(1.5rem, 3.5vw, 2.8rem); border: 1px solid var(--rule); border-top: 0; background: var(--surface); }
      .ru-workflow-panel__copy h3, .ru-recipe-panel__copy h3 { margin: 0; font-family: var(--mono); font-size: clamp(1.1rem, 2vw, 1.55rem); line-height: 1.28; letter-spacing: -0.02em; }
      .ru-workflow-panel__copy > p:not(.ru-panel-tag), .ru-recipe-panel__copy > p:not(.ru-panel-tag) { color: var(--ink-soft); }
      .ru-workflow-panel__copy > a, .ru-recipe-panel__copy > a { display: inline-block; margin-top: 0.6rem; }
      .ru-steps { padding: 0; margin: 1.2rem 0; list-style: none; }
      .ru-steps li { display: flex; align-items: center; gap: 0.75rem; padding: 0.45rem 0; border-bottom: 1px solid var(--rule); font-size: 0.9rem; }
      .ru-steps li span { color: var(--teal-dark); font-family: var(--mono); font-size: 0.68rem; font-weight: 850; }
      .ru-env { font-size: 0.84rem; }
      .ru-code-stack { display: grid; gap: 1rem; min-width: 0; align-content: start; }
      .ru-language-note { display: grid; gap: 0.35rem; padding: 0.9rem 1rem; border: 1px solid var(--rule); background: var(--surface-cool); font-size: 0.82rem; }
      .ru-language-note strong { font-family: var(--mono); }

      /* ── RECIPE TABS ── */
      .ru-recipe-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; padding: 1px; background: var(--rule); border: 1px solid var(--rule); }
      .ru-recipe-tabs button { display: grid; grid-template-columns: auto 1fr; gap: 0.1rem 0.75rem; min-height: 6.2rem; padding: 1rem 1.1rem; border: 0; background: var(--surface); text-align: left; cursor: pointer; transition: background-color var(--fast) var(--ease); }
      .ru-recipe-tabs button:hover { background: var(--surface-cool); }
      .ru-recipe-tabs button[aria-selected="true"] { background: var(--ink); color: var(--surface); }
      .ru-recipe-tabs button > span { grid-row: 1 / 3; color: var(--teal); font-family: var(--mono); font-size: 0.68rem; font-weight: 850; }
      .ru-recipe-tabs button[aria-selected="true"] > span { color: #62c5bc; }
      .ru-recipe-tabs strong { align-self: end; font-family: var(--mono); font-size: 0.86rem; }
      .ru-recipe-tabs small { color: var(--ink-faint); font-size: 0.75rem; }
      .ru-recipe-tabs button[aria-selected="true"] small { color: #b9b2a2; }
      .ru-recipe-panel { border-top: 0; }
      .ru-recipe-panel dl { margin: 1.1rem 0; }
      .ru-recipe-panel dl div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.8rem; padding: 0.45rem 0; border-bottom: 1px solid var(--rule); }
      .ru-recipe-panel dt, .ru-recipe-panel dd { margin: 0; font-size: 0.86rem; }
      .ru-recipe-panel dd { color: var(--ink-soft); }

      /* ── PUBLIC LIFETIMES ── */
      .ru-lifetimes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; padding: 1px; background: var(--rule); border: 1px solid var(--rule); }
      .ru-lifetimes article { min-width: 0; padding: clamp(1.3rem, 2.8vw, 1.9rem); background: var(--surface); }
      .ru-lifetime__label { margin: 0 0 0.8rem; font-family: var(--mono); font-size: 0.7rem; font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; }
      .ru-lifetime__label::before { content: ""; display: inline-block; width: 0.52rem; height: 0.52rem; margin-right: 0.48rem; background: currentColor; }
      .ru-lifetime__label--local { color: var(--teal-dark); }
      .ru-lifetime__label--try { color: var(--public); }
      .ru-lifetime__label--named { color: var(--named); }
      .ru-lifetime__label--self { color: var(--ink-soft); }
      .ru-lifetimes h3 { margin: 0; font-size: 1rem; }
      .ru-lifetimes h3 code { overflow-wrap: anywhere; }
      .ru-lifetimes article > p:not(.ru-lifetime__label) { color: var(--ink-soft); font-size: 0.91rem; }
      .ru-lifetimes article > strong { display: block; margin-top: 1rem; font-family: var(--mono); font-size: 0.72rem; }

      /* ── HOW IT WORKS ── */
      .ru-flows { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; }
      .ru-flow { padding: clamp(1.2rem, 2.8vw, 1.9rem); border: 1px solid var(--rule); background: var(--surface); }
      .ru-flow--public { background: #f7eee3; }
      .ru-flow__header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.65rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--rule); }
      .ru-flow__header strong { font-family: var(--mono); }
      .ru-flow__header small { color: var(--ink-faint); }
      .ru-status { width: 0.6rem; height: 0.6rem; }
      .ru-status--local { background: var(--teal); }
      .ru-status--public { background: var(--public); }
      .ru-flow ol { padding: 0; margin: 1.2rem 0 0; list-style: none; counter-reset: flow; }
      .ru-flow li { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 1rem; padding: 0 0 1.55rem 2rem; counter-increment: flow; }
      .ru-flow li:last-child { padding-bottom: 0; }
      .ru-flow li::before { content: counter(flow); position: absolute; left: 0; top: 0.05rem; display: grid; place-items: center; width: 1.05rem; height: 1.05rem; background: var(--ink); color: var(--surface); font-family: var(--mono); font-size: 0.58rem; font-weight: 850; }
      .ru-flow li:not(:last-child)::after { content: ""; position: absolute; left: 0.49rem; top: 1.15rem; bottom: 0.1rem; width: 1px; background: var(--ink); opacity: 0.3; }
      .ru-flow li > span { font-family: var(--mono); font-size: 0.84rem; font-weight: 800; }
      .ru-flow li > code, .ru-flow li > small { grid-column: 2; color: var(--ink-faint); font-size: 0.72rem; }

      /* ── BOUNDARIES ── */
      .ru-boundaries { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding: 1px; margin: 0; background: var(--rule); border: 1px solid var(--rule); list-style: none; }
      .ru-boundaries li { padding: 1.35rem; background: var(--surface); }
      .ru-boundaries strong, .ru-boundaries span { display: block; }
      .ru-boundaries strong { margin-bottom: 0.45rem; font-family: var(--mono); font-size: 0.86rem; }
      .ru-boundaries span { color: var(--ink-soft); font-size: 0.85rem; }

      /* ── FOOTER ── */
      .ru-footer { padding: 2.2rem 0 3rem; }
      .ru-footer__top { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; }
      .ru-footer nav { display: flex; flex-wrap: wrap; gap: 0.8rem 1.4rem; font-family: var(--mono); font-size: 0.72rem; font-weight: 650; }
      .ru-footer nav a:hover { color: var(--teal-dark); }
      .ru-footer > p { margin: 1rem 0 0; color: var(--ink-faint); font-family: var(--mono); font-size: 0.68rem; }

      /* ── RESPONSIVE ── */
      @media (max-width: 920px) {
        .ru-hero { grid-template-columns: 1fr; }
        .ru-hero h1 { max-width: 22ch; }
        .ru-section--split { grid-template-columns: 1fr; }
        .ru-section__intro { position: static; }
        .ru-workflow-panel, .ru-recipe-panel { grid-template-columns: 1fr; }
        .ru-flows { grid-template-columns: 1fr; }
        .ru-problems ul { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 700px) {
        body { font-size: 15px; }
        .ru-nav { align-items: flex-start; }
        .ru-nav__links { justify-content: flex-end; gap: 0.5rem 0.9rem; }
        .ru-nav__links a:nth-child(3) { display: none; }
        .ru-ledger { grid-template-columns: 1fr; }
        .ru-ledger a { border-right: 0; border-bottom: 1px solid var(--rule); }
        .ru-ledger a:last-child { border-bottom: 0; }
        .ru-workflow-tabs { grid-template-columns: 1fr; }
        .ru-workflow-tab { min-height: 7rem; }
        .ru-recipe-tabs { grid-template-columns: 1fr 1fr; }
        .ru-lifetimes { grid-template-columns: 1fr; }
        .ru-boundaries { grid-template-columns: 1fr; }
        .ru-setup-result { grid-template-columns: 1fr; }
        .ru-setup-result > span { grid-row: auto; }
        .ru-setup-result ul { display: grid; }
        .ru-flow__header { grid-template-columns: auto 1fr; }
        .ru-flow__header small { grid-column: 2; }
        .ru-problems ul { grid-template-columns: 1fr; }
      }

      @media (max-width: 480px) {
        .ru-page { padding: 0 1rem; }
        .ru-nav { display: block; }
        .ru-nav__links { justify-content: flex-start; margin-top: 0.9rem; }
        .ru-nav__links a:nth-child(1), .ru-nav__links a:nth-child(3) { display: none; }
        .ru-hero { padding-top: 2.5rem; }
        .ru-proof { display: grid; }
        .ru-recipe-tabs { grid-template-columns: 1fr; }
        .ru-recipe-tabs button { min-height: 5rem; }
        .ru-tabs { overflow-x: auto; padding-bottom: 0.2rem; }
        .ru-tabs button { flex: 0 0 auto; }
        .ru-workflow-panel, .ru-recipe-panel { padding: 1.1rem; }
        .ru-terminal { font-size: 0.74rem; }
        .ru-footer__top { align-items: flex-start; flex-direction: column; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: 1ms !important; }
      }
    </style>
  </body>
</html>
