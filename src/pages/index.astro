        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--fg-faint);
      }
      .ru-machine--tail { margin-top: 0.3rem; }

      /* ──────────────────────────────── INSTALL ─────────────────────────── */
      .ru-install { max-width: none; min-width: 0; }
      /* Tabs sit above the terminal as a segmented control, clearly
         separated. The active tab is an espresso "pressed" tab — an ink
         surface that echoes the dark terminal below it, instead of a cream
         tab melting into the dark title bar. */
      .ru-tabs { display: flex; gap: 0.45rem; margin-bottom: 0.7rem; }
      .ru-install__panel { position: relative; }
      .ru-tab {
        background: var(--bg-elev);
        color: var(--fg-dim);
        border: 2px solid var(--border);
        padding: 0.5rem 1rem;
        font-family: var(--mono);
        font-size: 0.84rem;
        font-weight: 700;
        cursor: pointer;
        touch-action: manipulation;
        transition: background-color var(--motion-fast) var(--ease), color var(--motion-fast) var(--ease);
      }
      .ru-tab.is-active { background: var(--fg); color: var(--bg-elev); }
      .ru-tab:hover:not(.is-active) { background: var(--bg-soft); color: var(--fg); }
      .ru-copy {
        position: absolute;
        top: 0.75rem;
        right: 0.8rem;
        min-width: 5rem;
        padding: 0.32rem 0.55rem;
        background: var(--bg);
        color: var(--fg);
        border: 1.5px solid var(--border);
        box-shadow: 2px 2px 0 0 var(--border);
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 800;
        cursor: pointer;
        touch-action: manipulation;
        transition: transform var(--motion-fast) var(--ease), box-shadow var(--motion-fast) var(--ease), background-color var(--motion-fast) var(--ease);
      }
      .ru-copy:hover { background: var(--bg-soft); transform: translate(-1px, -1px); box-shadow: 3px 3px 0 0 var(--border); }
      .ru-copy:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 var(--border); }
      .ru-copy.is-copied { background: var(--accent-fg); color: var(--bg-elev); }
      .ru-note { margin: 1.3rem 0 0; font-size: 0.92rem; color: var(--fg-dim); line-height: 1.6; }




      /* ──────────────────────────── RELEASES PANEL ─────────────────────── */
      .ru-install__panel--release:not([hidden]) { display: flex; flex-direction: column; gap: 0.8rem; padding: 1.4rem 1.6rem; border: 2px solid var(--border); margin-top: 0.6rem; }
      .ru-release__label { font-size: 0.88rem; color: var(--fg-dim); margin: 0; }
      .ru-release__link {
        font-family: var(--mono);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--fg);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
        transition: color var(--motion-fast) var(--ease);
      }
      .ru-release__link:hover { color: var(--accent-fg); }

      /* ──────────────────────────────── FOOTER ──────────────────────────── */
      .ru-footer { padding: 2.4rem 0 3rem; }
      .ru-footer__top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.4rem;
        flex-wrap: wrap;
        margin-bottom: 1.3rem;
      }
      .ru-footer__top nav { display: flex; gap: 1.4rem; font-size: 0.88rem; color: var(--fg-dim); }
      .ru-footer__top nav a { transition: color var(--motion-fast) var(--ease); }
      .ru-footer__top nav a:hover { color: var(--accent-fg); }
      .ru-footer__meta { font-size: 0.78rem; color: var(--fg-faint); margin: 0; }
      .ru-footer__meta a { text-decoration: underline; text-underline-offset: 2px; }
      .ru-footer__credits { font-size: 0.74rem; color: var(--fg-faint); margin: 0.5rem 0 0; }

      /* ────────────────────────── RESPONSIVE ──────────────────────────── */
      @media (max-width: 900px) {
        .ru-hero { grid-template-columns: 1fr; gap: 2.4rem; }
        .ru-hero__caption { text-align: left; }
        .ru-diagram { grid-template-columns: 1fr; }
      }
      @media (max-width: 680px) {
        .ru-modes { grid-template-columns: 1fr; }
        .ru-grid--problems { grid-template-columns: 1fr; }
        .ru-grid--problems > li:last-child:nth-child(odd) { grid-column: auto; width: auto; justify-self: stretch; }
        .ru-grid--features { grid-template-columns: 1fr; }
        .ru-nav { flex-direction: column; align-items: flex-start; gap: 0.85rem; }
        .ru-nav__links { width: 100%; justify-content: flex-start; gap: 0.7rem 1.25rem; font-size: 0.85rem; }
        .ru-terminal--sm { font-size: 0.875rem; }
        .ru-flow__label, .ru-node__role, .ru-hop__wire, .ru-machine__tab { font-size: 0.78rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          transition-duration: 1ms !important;
          animation-duration: 1ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
