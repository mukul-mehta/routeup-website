      { t: '14:02:08  200  req_Vx2mPq7nH5kR3tY8  GET      /api/users' },
      { t: '' },
      { t: 'press Ctrl-C to stop', c: C.dim },
    ],
  },
  {
    id: 'runner',
    tab: 'Let routeup run it',
    title: 'One command starts the app and route.',
    body: 'Configure the dev command once. Bare routeup assigns its port, starts it, waits for readiness, and cleans everything up together.',
    config: [
      '{',
      '  "name": "example-app",',
      '  "command": "pnpm dev --port ${PORT}",',
      '  "expose": {',
      '    "enabled": true,',
      '    "paths": ["/api/webhooks/*"]',
      '  }',
      '}',
    ],
    output: [
      { p: true, t: 'routeup' },
      { t: 'routeup', c: C.txt },
      { t: '  command pnpm dev --port ${PORT}' },
      { t: '  route   example-app' },
      { t: '  local   https://example-app.localhost', c: C.mint },
      { t: '  public  https://example-app.try.routeup.dev', c: C.amb },
      { t: '  target  / -> localhost:59370', c: C.sec },
      { t: '  status  waiting for localhost:59370', c: C.amb },
