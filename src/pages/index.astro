<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>routeup | stable HTTPS names for local apps</title>
    <meta
      name="description"
      content="Give local apps stable, trusted HTTPS names. Keep your current dev command or let routeup run it, then expose the same targets publicly when needed."
    />
    <meta property="og:title" content="routeup | stable HTTPS names for local apps" />
    <meta
      property="og:description"
      content="Use example-app.localhost instead of localhost:3000. Local by default, public only when you choose."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://routeup.dev/" />
    <meta property="og:site_name" content="routeup" />
    <meta property="og:image" content="https://routeup.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="routeup | stable HTTPS names for local apps" />
    <meta
      name="twitter:description"
      content="Use example-app.localhost instead of localhost:3000. Local by default, public only when you choose."
    />
    <meta name="twitter:image" content="https://routeup.dev/og.png" />
    <link rel="canonical" href="https://routeup.dev/" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101512" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#E9E3D2" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Theme init — inline in <head> to avoid a flash of the wrong theme.
      // Saved override wins; otherwise follow the OS.
      (function () {
        var theme = 'dark';
        try {
          theme =
            localStorage.getItem('routeup-theme') ||
            (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch (_e) {}
        document.documentElement.dataset.theme = theme;
        // Keep the browser-chrome color in step with the applied theme, not just the OS.
        var bg = theme === 'light' ? '#E9E3D2' : '#101512';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
          m.setAttribute('content', bg);
        });
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="ru-skip">Skip to main content</a>
