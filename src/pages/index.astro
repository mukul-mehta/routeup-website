      .ru-recipe-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .ru-recipe-controls { display: none; }
      .ru-recipes { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 20px; margin-top: 36px; align-items: start; }
      .ru-rlist {
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: var(--hair-soft);
        border: 1px solid var(--hair-soft);
        border-radius: 6px;
        overflow: hidden;
      }
      .ru-rrow {
        display: flex;
        gap: 14px;
        align-items: baseline;
        text-align: left;
        width: 100%;
        border: 0;
        border-left: 2px solid transparent;
        background: transparent;
        padding: 16px 18px;
        cursor: pointer;
        transition: background .15s;
        color: var(--txt);
        font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
        -webkit-user-select: text;
        user-select: text;
      }
      .ru-rrow * { -webkit-user-select: text; user-select: text; }
      .ru-rrow__n { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--sec); }
      .ru-rrow__body { min-width: 0; }
      .ru-rrow__t { display: block; font-size: 15.5px; letter-spacing: -.01em; color: var(--txt); }
      .ru-rrow__s { display: block; margin-top: 2px; font-size: 13px; line-height: 1.5; color: var(--sec); font-weight: 400; }
      .ru-rrow[aria-selected="true"] { border-left-color: var(--mint); background: var(--mint-bg2); }
      .ru-rrow[aria-selected="true"] .ru-rrow__t { color: var(--mint-hover); }

      .ru-detail {
        width: 100%;
        min-width: 0;
        height: auto;
        max-height: var(--recipe-max-height, 600px);
        border: 1px solid var(--terminal-border);
        border-radius: 6px;
        background: var(--terminal-bg);
        color: var(--terminal-text);
        overflow: hidden;
        position: sticky;
        top: 20px;
        display: flex;
        flex-direction: column;
        scroll-margin-top: 20px;
        box-shadow: 0 16px 38px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.035);
      }
      .ru-dpanel { display: flex; flex-direction: column; width: 100%; min-width: 0; max-height: var(--recipe-max-height, 600px); overflow: auto; scrollbar-color: var(--terminal-border) var(--terminal-bg); }
      .ru-dtitle { padding: 8px 16px; border-bottom: 1px solid var(--terminal-border); font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--terminal-dim); }
      .ru-dtitle--cfg { border-top: 1px solid var(--terminal-border); }
      .ru-dterm { flex: none; padding: 16px; background: var(--terminal-bg); font-family: 'JetBrains Mono', monospace; font-size: 12.5px; line-height: 1.85; overflow-x: auto; }
      .ru-dterm .ru-pre span { color: var(--terminal-muted); }
      .ru-dterm .ru-pre span.c-txt { color: var(--terminal-text); }
      .ru-dterm .ru-pre span.c-mint { color: var(--terminal-local); }
      .ru-dterm .ru-pre span.c-amb { color: var(--terminal-public); }
      .ru-dterm .ru-pre span.c-dim  { color: var(--terminal-dim); }
      .ru-dterm .ru-pre span.c-sec  { color: var(--terminal-sec); }
      .ru-dterm .ru-pre span.c-gray { color: var(--terminal-muted); }
      .ru-dcfg { flex: none; padding: 14px 16px; background: var(--editor-bg); font-family: 'JetBrains Mono', monospace; font-size: 12.5px; line-height: 1.75; color: var(--terminal-sec); overflow-x: auto; }
      .ru-detail.swap-a [data-anim] { animation: ru-swap-a .25s ease both; }
      .ru-detail.swap-b [data-anim] { animation: ru-swap-b .25s ease both; }

      /* ── Where requests go ────────────────────────────────────────────── */
      #how > h2, #how > .ru-intro, #how > .ru-footnote { text-align: left; }
      .ru-legend { display: flex; gap: 22px; margin-top: 32px; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; }
      .ru-legend__i { display: inline-flex; align-items: center; gap: 8px; }
      .ru-legend__sw { width: 7px; height: 7px; display: block; }
      .ru-legend__sw--mint { background: var(--mint); }
      .ru-legend__sw--amb { background: var(--amb); }

      .ru-net {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) 34px minmax(0, 1fr) 34px minmax(0, 1fr) 34px minmax(0, .9fr);
        grid-template-rows: auto auto;
        gap: 18px 0;
        margin-top: 18px;
        border: 1px solid var(--hair);
        border-radius: 6px;
        padding: 26px;
      }
      .ru-node {
        border: 1px solid var(--hair-mid);
        background: var(--panel);
        padding: 12px 16px;
        border-radius: 3px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        text-align: center;
        align-self: center;
        min-width: 0;
      }
      .ru-node--browser { grid-column: 1; grid-row: 1; border-color: var(--mint-bd); }
      .ru-node--client { grid-column: 1; grid-row: 2; border-color: var(--amb-bd); }
      .ru-node--server { grid-column: 3; grid-row: 2; }
      .ru-node--agent { grid-column: 5; grid-row: 1 / 3; align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
      .ru-node--app { grid-column: 7; grid-row: 1 / 3; align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
      .ru-node__sub { color: var(--gray); margin-top: 4px; }
      .ru-node__sub--mint { color: var(--mint); font-size: 11.5px; word-break: break-all; }
      .ru-node__sub--amb { color: var(--amb); font-size: 11.5px; word-break: break-all; }
      .ru-node__sub--trunc { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      .ru-nline { align-self: center; position: relative; height: 1px; margin: 0 -1px; }
      .ru-nline--l1 { grid-column: 2 / 5; grid-row: 1; background: var(--mint-bd2); }
      .ru-nline--l2 { grid-column: 2; grid-row: 2; background: var(--amb-bd2); }
      .ru-nline--l3 { grid-column: 4; grid-row: 2; background: var(--amb-bd2); }
      .ru-nline--l4 { grid-column: 6; grid-row: 1 / 3; background: var(--line-neutral); }
      .ru-flow-dot { position: absolute; top: -2.5px; width: 6px; height: 6px; border-radius: 50%; animation: ru-flow 2.6s linear 0s infinite; }
      .ru-nline--l1 .ru-flow-dot { background: var(--mint-solid); }
      .ru-nline--l2 .ru-flow-dot { background: var(--amb-solid); }
      .ru-nline--l3 .ru-flow-dot { background: var(--amb-solid); animation-delay: .8s; }
      .ru-nline--l4 .ru-flow-dot { background: var(--txt); animation-delay: .4s; }

      .ru-footnote { width: 100%; margin: 16px 0 0; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; line-height: 1.6; color: var(--gray); text-align: center; }

      /* ── Going public ─────────────────────────────────────────────────── */
      .ru-urlcards { align-items: start; }
      .ru-urlcard { border: 1px solid var(--hair); border-radius: 6px; background: var(--panel); overflow: hidden; }
      .ru-urlcard__head { position: relative; z-index: 2; padding: 16px 22px; border-bottom: 1px solid var(--hair-faint); }
      .ru-urlcard__tag { display: flex; align-items: center; gap: 7px; margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; }
      .ru-token-help-wrap { position: relative; display: inline-flex; }
      .ru-token-help { display: inline-flex; align-items: center; justify-content: center; width: 17px; height: 17px; padding: 0; border: 1px solid currentColor; border-radius: 50%; background: transparent; color: inherit; font: inherit; font-size: 10px; font-weight: 700; line-height: 1; letter-spacing: 0; cursor: help; opacity: .8; }
      .ru-token-help:hover, .ru-token-help:focus-visible { opacity: 1; }
      .ru-token-tooltip { position: absolute; top: calc(100% + 9px); left: -80px; z-index: 10; width: min(260px, calc(100vw - 64px)); padding: 9px 11px; border: 1px solid var(--hair-strong); border-radius: 4px; background: var(--panel2); box-shadow: 0 8px 20px rgba(0,0,0,.24); color: var(--sec); font-family: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size: 12.5px; font-weight: 400; line-height: 1.45; letter-spacing: 0; text-transform: none; opacity: 0; visibility: hidden; transform: translateY(-3px); transition: opacity .14s, transform .14s, visibility .14s; pointer-events: none; }
      .ru-token-help-wrap:hover .ru-token-tooltip, .ru-token-help-wrap:focus-within .ru-token-tooltip { opacity: 1; visibility: visible; transform: translateY(0); }
      .ru-urlcard__head h3 { margin: 8px 0 0; font-size: 19px; letter-spacing: -.015em; font-weight: 700; }
      .ru-urlcard__term { padding: 16px 22px 18px; border-block: 1px solid var(--terminal-border); background: var(--terminal-bg); color: var(--terminal-text); font-family: 'JetBrains Mono', monospace; font-size: 12.5px; line-height: 1.8; overflow-x: auto; }
      .ru-urlcard__term::before { content: 'terminal'; display: block; margin: -16px -22px 14px; padding: 8px 16px 8px 58px; border-bottom: 1px solid var(--terminal-border); background: radial-gradient(circle at 18px 50%, var(--terminal-red) 0 3px, transparent 3.5px), radial-gradient(circle at 29px 50%, var(--terminal-yellow) 0 3px, transparent 3.5px), radial-gradient(circle at 40px 50%, var(--terminal-green) 0 3px, transparent 3.5px), var(--terminal-bar); color: var(--terminal-dim); font-size: 11px; line-height: 1.4; }
      .ru-urlcard__foot { margin: 0; padding: 18px 22px 20px; font-size: 14.5px; line-height: 1.6; color: var(--sec); }
      .ru-inline-cta { display: block; margin-top: 12px; font-family: 'JetBrains Mono', monospace; font-size: 12.5px; font-weight: 700; }

      .ru-token-form-sect { padding: 16px 22px 20px; border-top: 1px solid var(--hair); }
      .ru-token-form__note { margin: 6px 0 0; font-size: 12.5px; color: var(--dim); line-height: 1.5; }
      .ru-token-form__privacy { margin: 10px 0 0; font-size: 11.5px; color: var(--dim); line-height: 1.5; }
      .ru-token-form__privacy a { color: var(--sec); text-decoration: underline; text-underline-offset: 2px; }
      .ru-token-form { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
      .ru-token-form__label { margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--mint); }
      .ru-token-form__row { display: flex; align-items: stretch; }
      .ru-token-form__input {
        width: 100%;
        padding: 9px 11px;
        background: var(--bg);
        border: 1px solid var(--hair-mid);
        border-radius: 4px;
        color: var(--txt);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        line-height: 1.4;
      }
      .ru-token-form__input::placeholder { color: var(--dim); }
      .ru-token-form__input:focus { outline: 2px solid var(--mint); outline-offset: -1px; }
      .ru-token-form__input--ns { border-right: 0; border-radius: 4px 0 0 4px; }
      .ru-token-form__ns-suffix {
        flex: none;
        padding: 9px 10px;
        background: var(--panel);
        border: 1px solid var(--hair-mid);
        border-left: 0;
        border-radius: 0 4px 4px 0;
        color: var(--dim);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        line-height: 1.4;
        white-space: nowrap;
      }
      .ru-token-form__submit {
        align-self: flex-start;
        padding: 9px 16px;
        background: var(--mint);
        color: var(--bg);
        border: 0;
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 4px;
      }
      .ru-token-form__submit:hover { background: var(--mint-hover); }
      .ru-token-form__submit:disabled { opacity: .6; cursor: default; }
      .ru-token-form__msg { margin: 4px 0 0; font-size: 13.5px; line-height: 1.5; }
      .ru-token-form__msg--ok { color: var(--mint); font-family: 'JetBrains Mono', monospace; font-size: 13px; }
      .ru-token-form__msg--err { color: var(--sec); }
      .ru-token-form__msg--err a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

      :is(.ru-term, .ru-codecard__body, .ru-dterm, .ru-dcfg, .ru-urlcard__term) { color: var(--terminal-text); font-variant-numeric: tabular-nums; }
      :is(.ru-term, .ru-codecard__body, .ru-dterm, .ru-dcfg, .ru-urlcard__term) .ru-pre span { background-color: var(--terminal-bg, #090C0B); }
      :is(.ru-term, .ru-codecard__body, .ru-dcfg, .ru-urlcard__term) .c-txt { color: var(--terminal-text); }
      :is(.ru-term, .ru-codecard__body, .ru-dcfg, .ru-urlcard__term) .c-sec { color: var(--terminal-sec); }
      :is(.ru-term, .ru-codecard__body, .ru-dcfg, .ru-urlcard__term) .c-gray { color: var(--terminal-muted); }
      :is(.ru-term, .ru-codecard__body, .ru-dcfg, .ru-urlcard__term) .c-dim { color: var(--terminal-dim); }
      :is(.ru-term, .ru-codecard__body, .ru-dcfg, .ru-urlcard__term) .c-mint { color: var(--terminal-local); }
      :is(.ru-term, .ru-codecard__body, .ru-dcfg, .ru-urlcard__term) .c-amb { color: var(--terminal-public); }
      :is(.ru-codecard__body, .ru-dcfg) .c-json-key { color: var(--terminal-json-key); }
      :is(.ru-codecard__body, .ru-dcfg) .c-json-string { color: var(--terminal-json-string); }
      :is(.ru-codecard__body, .ru-dcfg) .c-json-number { color: var(--terminal-json-number); }
      :is(.ru-codecard__body, .ru-dcfg) .c-json-literal { color: var(--terminal-json-literal); }
      :is(.ru-codecard__body, .ru-dcfg) .c-json-punctuation { color: var(--terminal-json-punctuation); }

      /* ── Install ──────────────────────────────────────────────────────── */
      .ru-install-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; }
      .ru-install-card { min-width: 0; padding: 22px; border: 1px solid var(--hair-mid); border-radius: 6px; background: var(--panel); }
      .ru-install-card__tag { margin: 0; color: var(--mint); font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; }
      .ru-install-card h3 { margin: 8px 0 18px; font-size: 19px; }
      .ru-install-card--agent { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; padding-block: 12px; }
      .ru-install-card__agent-desc { margin: 0; color: var(--sec); font-size: 13px; }
      .ru-install-card__link { font-family: 'JetBrains Mono', monospace; font-size: 13px; white-space: nowrap; }
      .ru-install-card--setup { grid-column: 1 / -1; }
      .ru-install-command { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--terminal-border); border-radius: 4px; background: var(--terminal-bg); color: var(--terminal-local); text-align: left; cursor: pointer; }
      .ru-install-command:hover { border-color: var(--terminal-local); }
      .ru-install-command code { min-width: 0; overflow: hidden; color: var(--terminal-text); font-family: 'JetBrains Mono', monospace; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
      .ru-install-command__action { color: var(--terminal-dim); font-family: 'JetBrains Mono', monospace; font-size: 10.5px; text-transform: uppercase; }
      .ru-install-command.is-copied { border-color: var(--terminal-local); }
      .ru-install-command.is-copied .ru-install-command__action { color: var(--terminal-local); }
      .ru-setup-term { padding: 16px 18px 18px; border: 1px solid var(--terminal-border); border-radius: 4px; background: var(--terminal-bg); color: var(--terminal-text); font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.8; overflow-x: auto; }
      .ru-setup-term .ru-pre span { background-color: var(--terminal-bg); }
      .ru-setup-term .c-txt { color: var(--terminal-text); }
      .ru-setup-term .c-mint { color: var(--terminal-local); }
      .ru-setup-term .c-dim { color: var(--terminal-dim); }

      /* ── Product outcomes ────────────────────────────────────────────── */
      .ru-why {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1px;
        background: var(--hair-soft);
        border: 1px solid var(--hair-soft);
        border-radius: 4px;
        overflow: hidden;
      }
      .ru-why__cell { background: var(--panel); padding: 20px 22px; }
      .ru-why__tag { margin: 0 0 8px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--amb); letter-spacing: .08em; }
      .ru-why__copy { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--sec); }

      /* ── Local first ──────────────────────────────────────────────────── */
      .ru-final { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
      .ru-final__copy { margin: 18px 0 22px; font-size: 16px; line-height: 1.6; color: var(--sec); }
      .ru-contact-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
      .ru-contact-list li { position: relative; padding-left: 16px; color: var(--sec); font-size: 14.5px; line-height: 1.5; }
      .ru-contact-list li::before { content: ''; position: absolute; top: .55em; left: 0; width: 5px; height: 5px; background: var(--mint); }
      .ru-contact-list strong { color: var(--txt); }
      .ru-contact-list a { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; white-space: nowrap; }
      .ru-facts {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--hair-soft);
        border: 1px solid var(--hair-soft);
        border-radius: 6px;
        overflow: hidden;
      }
      .ru-facts li { background: var(--panel); padding: 18px 22px; }
      .ru-facts strong { display: block; font-size: 15px; margin-bottom: 4px; }
      .ru-facts span { font-size: 14px; color: var(--sec); }

      /* ── Footer ───────────────────────────────────────────────────────── */
      .ru-footer {
        margin-top: 96px;
        padding: 28px 0 48px;
        border-top: 1px solid var(--hair-soft);
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: space-between;
        align-items: center;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--gray);
      }
      .ru-footer nav { display: flex; flex-wrap: wrap; gap: 12px 20px; max-width: 100%; margin-left: auto; }
      .ru-footer a { color: var(--sec); }
      .ru-footer a:hover { color: var(--txt); }

      /* ── Responsive ───────────────────────────────────────────────────── */
      @media (max-width: 1080px) {
        .ru-2col { grid-template-columns: 1fr !important; }
        .ru-3col { grid-template-columns: 1fr 1fr !important; }
        .ru-hero { padding-top: 56px !important; padding-bottom: 56px !important; }
        .ru-why { grid-template-columns: repeat(3, 1fr) !important; }
        .ru-recipes { grid-template-columns: 1fr !important; }
        .ru-detail { position: static !important; max-height: none !important; }
        .ru-dpanel { max-height: none !important; overflow: visible; }
        .ru-recipe-controls { display: inline-grid; grid-template-columns: 32px auto 32px; align-items: stretch; flex: none; min-height: 32px; border: 1px solid var(--hair-mid); border-radius: 4px; overflow: hidden; background: var(--panel2); }
        .ru-recipe-controls button { display: grid; place-items: center; padding: 0; border: 0; background: transparent; color: var(--mint); font-family: 'JetBrains Mono', monospace; font-size: 13px; cursor: pointer; }
        .ru-recipe-controls button:first-child { border-right: 1px solid var(--hair-mid); }
        .ru-recipe-controls button:last-child { border-left: 1px solid var(--hair-mid); }
        .ru-recipe-controls button:hover:not(:disabled) { background: var(--mint-bg); color: var(--mint-hover); }
        .ru-recipe-controls button:disabled { color: var(--dim); cursor: default; opacity: .45; }
        .ru-recipe-controls span { display: grid; place-items: center; min-width: 30px; padding: 0 4px; color: var(--sec); font-family: 'JetBrains Mono', monospace; font-size: 8px; font-variant-numeric: tabular-nums; }
        .ru-recipes { margin-top: 20px; }
        .ru-rlist { display: flex; flex-direction: row; gap: 8px; padding: 0 0 10px; border: 0; border-radius: 0; background: transparent; overflow-x: auto; overscroll-behavior-inline: contain; scroll-padding-inline: 1px; scroll-snap-type: inline mandatory; scrollbar-width: none; }
        .ru-rlist::-webkit-scrollbar { display: none; }
        .ru-rrow { display: grid; grid-template-columns: 22px minmax(0, 1fr); flex: 0 0 clamp(160px, 46vw, 190px); width: auto; min-height: 58px; align-items: center; gap: 8px; padding: 9px 11px; border: 1px solid var(--hair); border-top: 2px solid transparent; border-radius: 5px; background: var(--panel); scroll-snap-align: start; }
        .ru-rrow__n { font-size: 10px; }
        .ru-rrow__t { font-size: 14px; line-height: 1.25; }
        .ru-rrow__s { display: none; }
        .ru-rrow:hover { border-color: var(--mint-bd); background: var(--mint-bg4); }
        .ru-rrow[aria-selected="true"] { border-color: var(--mint-bd); border-top-color: var(--mint); background: var(--mint-bg2); }
      }
      @media (max-width: 1160px) {
        .ru-hero { grid-template-columns: 1fr !important; }
      }
      @media (max-width: 900px) {
        .ru-net {
          display: grid !important;
          grid-template-columns: 1fr 1fr !important;
          gap: 0 16px !important;
          align-items: start !important;
          padding: 18px !important;
        }
        .ru-nline .ru-flow-dot { display: none !important; }
        .ru-node { font-size: 11px !important; padding: 10px 12px !important; }
        .ru-node__sub--mint, .ru-node__sub--amb {
          white-space: nowrap !important;
          overflow: hidden !important;
          text-overflow: ellipsis !important;
          word-break: normal !important;
          font-size: 10.5px !important;
        }
        .ru-node--browser { grid-column: 1 !important; grid-row: 1 !important; border-color: var(--mint-bd) !important; align-self: auto !important; }
        .ru-node--client  { grid-column: 2 !important; grid-row: 1 !important; border-color: var(--amb-bd) !important; align-self: auto !important; }
        .ru-nline--l1 { grid-column: 1 !important; grid-row: 2 / 5 !important; width: 2px !important; height: auto !important; align-self: stretch !important; background: var(--mint-bd2) !important; margin: 0 0 0 18px !important; }
