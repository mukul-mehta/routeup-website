            ))}
          </div>
          {runModes.map((mode, index) => (
            <div
              class="ru-mode-panel"
              role="tabpanel"
              id={`mode-panel-${mode.id}`}
              aria-labelledby={`mode-tab-${mode.id}`}
              hidden={index !== 0}
            >
              <div class="ru-mode-copy">
                <h3>{mode.title}</h3>
                <p>{mode.body}</p>
              </div>
              <div class="ru-cards2 ru-2col">
                <div class="ru-codecard ru-codecard--editor">
                  <div class="ru-codecard__title ru-editor__title">routeup.json</div>
                  <div class="ru-codecard__body ru-editor__body" translate="no" tabindex="0"><pre class="ru-pre">{mode.config.map((line, i) => <span class="ru-editor-line"><span class="ru-editor-line__number" aria-hidden="true">{i + 1}</span><span>{jsonSegs(line).map((s) => <span class={s.c}>{s.t}</span>)}</span></span>)}</pre></div>
                </div>
                <div class="ru-codecard">
                  <div class="ru-codecard__title">terminal</div>
                  <div class="ru-codecard__body" translate="no" tabindex="0"><pre class="ru-pre">{mode.output.map((line, i) => <>{i > 0 && '\n'}{line.p ? <><span class="c-mint">$ </span><span class="c-txt">{line.t}</span></> : <span class={line.c || C.gray}>{line.t}</span>}</>)}</pre></div>
                </div>
              </div>
            </div>
          ))}
          <div class="ru-mode-link">
            <a href="/docs/configuration/routeup-json">Configuration reference →</a>
          </div>
        </section>

        <section id="recipes" class="ru-section">
          <h2>Pick a recipe.</h2>
            <div class="ru-recipes ru-2col">
              <details class="ru-recipe-dd" id="ru-recipe-dd">
                <summary class="ru-recipe-dd__trigger">
                  <span class="ru-recipe-dd__label">{recipes[0]?.title}</span>
                  <svg aria-hidden="true" width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </summary>
                <ul class="ru-recipe-dd__list">
                  {recipes.map((r, i) => (
                    <li class="ru-recipe-dd__opt" data-recipe-hash={`recipe-${recipeSlug(r.title)}`} aria-selected={i === 0 ? 'true' : 'false'}>{r.title}</li>
                  ))}
                </ul>
              </details>
              <div class="ru-rlist" role="tablist" aria-label="Recipes" aria-orientation="vertical">
              {recipes.map((r, i) => (
                <button
                  type="button"
                  class="ru-rrow"
                  role="tab"
                  id={`tab-recipe-${i}`}
                    aria-controls={`recipe-panel-${recipeSlug(r.title)}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    data-recipe-hash={`recipe-${recipeSlug(r.title)}`}
                    tabindex={i === 0 ? 0 : -1}
                >
                  <span class="ru-rrow__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="ru-rrow__body">
                    <strong class="ru-rrow__t">{r.title}</strong>
                    <span class="ru-rrow__s">{r.body}</span>
                  </span>
                </button>
              ))}
            </div>
            <div class="ru-detail swap-b">
              {recipes.map((r, i) => (
                <div
                  class="ru-dpanel"
                  role="tabpanel"
                  id={`recipe-panel-${recipeSlug(r.title)}`}
                  aria-labelledby={`tab-recipe-${i}`}
                  hidden={i !== 0}
                >
                  <div class="ru-dtitle">terminal</div>
                  <div class="ru-dterm" translate="no" tabindex="0"><pre class="ru-pre" data-anim>{r.out.map((l, j) => <>{j > 0 && '\n'}{'p' in l && l.p ? <><span class="c-mint">$ </span><span class="c-txt">{l.t}</span></> : <span class={l.c || C.gray}>{l.t}</span>}</>)}</pre></div>
                  {r.cfg && (
                    <>
                      <div class="ru-dtitle ru-dtitle--cfg ru-editor__title">routeup.json</div>
                      <div class="ru-dcfg ru-editor__body" translate="no" tabindex="0"><pre class="ru-pre" data-anim>{r.cfg.map((line, j) => <span class="ru-editor-line"><span class="ru-editor-line__number" aria-hidden="true">{j + 1}</span><span>{jsonSegs(line).map((s) => <span class={s.c}>{s.t}</span>)}</span></span>)}</pre></div>
                    </>
                  )}
                  {'inspect' in r && r.inspect && (
                    <>
                      <div class="ru-dtitle ru-dtitle--cfg">inspect view</div>
                      <div class="ru-dterm" translate="no" tabindex="0"><pre class="ru-pre" data-anim>{(r.inspect as {t: string; c?: string; p?: boolean}[]).map((l, j) => <>{j > 0 && '\n'}{l.p ? <><span class="c-mint">$ </span><span class="c-txt">{l.t}</span></> : <span class={l.c || C.gray}>{l.t}</span>}</>)}</pre></div>
                    </>
                  )}
