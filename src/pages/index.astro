/**
 * routeup.dev landing page.
 *
 * Dual-theme design: warm graphite or paper canvas,
 * Space Grotesk + JetBrains Mono, strict color rule — mint = local/trusted,
 * amber = public/exposed. Theme follows the OS by default; a user override
 * persists in localStorage under `routeup-theme`.
 */

// Self-hosted fonts avoid third-party font requests.
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import SiteHeader from '../components/SiteHeader.astro';
import TelemetryNotice from '../components/TelemetryNotice.astro';

// Terminal-line color classes. Default (unset) renders as --gray.
const C = {
  txt: 'c-txt', sec: 'c-sec', gray: 'c-gray', dim: 'c-dim', mint: 'c-mint', amb: 'c-amb',
  jsonKey: 'c-json-key', jsonString: 'c-json-string', jsonNumber: 'c-json-number', jsonLiteral: 'c-json-literal', jsonPunctuation: 'c-json-punctuation',
};

