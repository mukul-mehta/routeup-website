    <script is:inline>
      (function () {
        var live = document.querySelector('.ru-sr-live');
        var root = document.documentElement;

        /* ── Theme ─────────────────────────────────────────────────────── */
        var mq = window.matchMedia('(prefers-color-scheme: light)');
        mq.addEventListener('change', function () {
          // Follow the OS only while the user has no saved override.
          var saved = null;
          try { saved = localStorage.getItem('routeup-theme'); } catch (_e) {}
          if (!saved) root.dataset.theme = mq.matches ? 'light' : 'dark';
        });

        var animTimer;
        document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
          root.classList.add('theme-anim');
          clearTimeout(animTimer);
          animTimer = setTimeout(function () { root.classList.remove('theme-anim'); }, 350);
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          // Keep the docs (Starlight) theme in sync so the choice carries across pages.
          try {
            localStorage.setItem('routeup-theme', next);
            localStorage.setItem('starlight-theme', next);
          } catch (_e) {}
          var bg = next === 'light' ? '#E9E3D2' : '#101512';
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.setAttribute('content', bg);
          });
        });

        /* ── Mobile menu ───────────────────────────────────────────────── */
        var burger = document.querySelector('.ru-burger');
        var menu = document.getElementById('ru-menu');
        burger.addEventListener('click', function () {
          var open = menu.classList.toggle('is-open');
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        menu.addEventListener('click', function () {
          menu.classList.remove('is-open');
          burger.setAttribute('aria-expanded', 'false');
        });

        /* ── Copy install commands ─────────────────────────────────────── */
        document.querySelectorAll('[data-copy]').forEach(function (button) {
          var timer;
          button.addEventListener('click', async function () {
            var action = button.querySelector('.ru-install-command__action');
            try {
              await navigator.clipboard.writeText(button.getAttribute('data-copy') || '');
              button.classList.add('is-copied');
              if (action) action.textContent = 'Copied';
              if (live) live.textContent = 'Command copied to clipboard';
            } catch (_error) {
              if (action) action.textContent = 'Try again';
              if (live) live.textContent = 'Could not copy command';
            }
            clearTimeout(timer);
            timer = setTimeout(function () {
              button.classList.remove('is-copied');
              if (action) action.textContent = 'Copy';
            }, 1500);
          });
        });

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ── Run mode switcher ─────────────────────────────────────────── */
        var modeTabs = Array.prototype.slice.call(document.querySelectorAll('.ru-mode-tab'));
        var modePanels = Array.prototype.slice.call(document.querySelectorAll('.ru-mode-panel'));

        function activateMode(tab, moveFocus) {
          var target = tab.getAttribute('aria-controls');
          modeTabs.forEach(function (item) {
            var active = item === tab;
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            item.setAttribute('tabindex', active ? '0' : '-1');
          });
          modePanels.forEach(function (panel) { panel.hidden = panel.id !== target; });
          if (moveFocus) tab.focus();
        }

        modeTabs.forEach(function (tab) {
          tab.addEventListener('click', function () { activateMode(tab, false); });
          tab.addEventListener('keydown', function (event) {
            var index = modeTabs.indexOf(tab);
            var next = index;
            if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % modeTabs.length;
            else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + modeTabs.length) % modeTabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = modeTabs.length - 1;
            else return;
            event.preventDefault();
            activateMode(modeTabs[next], true);
          });
        });

        /* ── Recipe master–detail ──────────────────────────────────────── */
        var detail = document.querySelector('.ru-detail');
        var recipeList = document.querySelector('.ru-rlist');
        var recipeDD = document.getElementById('ru-recipe-dd');
        var recipeDDLabel = recipeDD && recipeDD.querySelector('.ru-recipe-dd__label');
        var recipeDDOpts = recipeDD ? Array.prototype.slice.call(recipeDD.querySelectorAll('.ru-recipe-dd__opt')) : [];
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.ru-rrow'));
        var panels = Array.prototype.slice.call(document.querySelectorAll('.ru-dpanel'));
        var swap = 0;

        function syncRecipeHeightLimit() {
          if (!detail || !recipeList) return;
          var listHeight = recipeList.getBoundingClientRect().height;
          var limit = window.matchMedia('(max-width: 1080px)').matches
            ? 360
            : listHeight;
          detail.style.setProperty('--recipe-max-height', Math.round(limit) + 'px');
        }

        function activate(tab, moveFocus, updateURL, revealPanel) {
          var target = tab.getAttribute('aria-controls');
          tabs.forEach(function (item) {
            var active = item === tab;
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            item.setAttribute('tabindex', active ? '0' : '-1');
          });
          panels.forEach(function (panel) {
            panel.hidden = panel.id !== target;
          });
          // Alternate two identical keyframes so the fade restarts every click.
          swap++;
          detail.classList.toggle('swap-a', swap % 2 === 1);
          detail.classList.toggle('swap-b', swap % 2 === 0);
          if (updateURL) {
            var hash = '#' + tab.getAttribute('data-recipe-hash');
            if (window.location.hash !== hash) history.pushState(null, '', hash);
          }
          if (moveFocus) tab.focus();
          if (revealPanel && window.matchMedia('(max-width: 1080px)').matches) {
            detail.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          }
          var activeHash = tab.getAttribute('data-recipe-hash');
          if (recipeDDLabel) recipeDDLabel.textContent = tab.querySelector('.ru-rrow__t') ? tab.querySelector('.ru-rrow__t').textContent : '';
          recipeDDOpts.forEach(function(opt) { opt.setAttribute('aria-selected', opt.getAttribute('data-recipe-hash') === activeHash ? 'true' : 'false'); });
          if (recipeDD) recipeDD.open = false;
        }

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () { activate(tab, false, true, true); });
          tab.addEventListener('keydown', function (event) {
            var index = tabs.indexOf(tab);
            var next = index;
            if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
            else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = tabs.length - 1;
            else return;
            event.preventDefault();
            activate(tabs[next], true, true, false);
          });
        });

        function activateFromHash() {
          var hash = window.location.hash.slice(1);
          var tab = tabs.find(function (item) { return item.getAttribute('data-recipe-hash') === hash; }) || tabs[0];
          activate(tab, false, false, false);
        }

        recipeDDOpts.forEach(function(opt) {
          opt.addEventListener('click', function() {
            var hash = opt.getAttribute('data-recipe-hash');
            var t = tabs.find(function(tb) { return tb.getAttribute('data-recipe-hash') === hash; });
            if (t) activate(t, false, true, false);
          });
        });
        if (recipeDD) {
          document.addEventListener('click', function(e) {
