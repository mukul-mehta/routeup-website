      }
      .ru-btn--primary { background: var(--accent-fg); color: var(--bg-elev); box-shadow: 3px 3px 0 0 var(--border); }
      .ru-btn--ghost   { background: var(--bg-elev); color: var(--fg); box-shadow: 3px 3px 0 0 var(--border); }
      .ru-btn:hover  { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 0 var(--border); }
      .ru-btn:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 0 var(--border); }

      /* ───────────────────────────── SECTIONS ───────────────────────────── */
      #how, #install { scroll-margin-top: 4.5rem; }
      .ru-section { padding: clamp(3rem, 6vw, 4.5rem) 0; border-bottom: 1px solid var(--rule); }
      .ru-section:last-of-type { border-bottom: none; }
      .ru-head { margin-bottom: 2.4rem; }
      .ru-kicker { font-size: 0.84rem; font-weight: 700; color: var(--accent-fg); margin: 0 0 0.9rem; }
