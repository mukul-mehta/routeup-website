      }
      .ru-hop__wire { font-size: 0.76rem; color: var(--fg-faint); }
      .ru-hop__wire--public { color: var(--public); font-weight: 600; }
      .ru-hop--tunnel::before { background: var(--accent); opacity: 0.6; }
      .ru-hop--tunnel .ru-hop__wire { color: var(--accent-fg); font-weight: 600; }

      /* "your machine" boundary box */
      .ru-machine {
        position: relative;
        border: 1.5px solid var(--border);
        padding: 1.15rem 1.1rem 1.1rem;
        margin: 0.2rem 0;
      }
      .ru-machine__tab {
        position: absolute;
        top: -0.62rem;
